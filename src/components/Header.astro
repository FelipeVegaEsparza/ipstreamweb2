---
import { NAV, SITE } from '../lib/site';
import { getLocale, localizedPath, t } from '../lib/i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';

const locale = getLocale(Astro.locals);
const { email = SITE.email } = Astro.props as { email?: string };
const currentPath = Astro.locals.pathWithoutLocale ?? Astro.url.pathname;
const tr = t(locale);
const nav = NAV.map((item) => ({ href: localizedPath(locale, item.href), base: item.href, label: tr(item.key) }));
const isActive = (base: string) => (base === '/' ? currentPath === '/' : currentPath.startsWith(base));
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={localizedPath(locale, '/')} aria-label={`${SITE.name} ${locale === 'en' ? 'home' : 'inicio'}`}>
      <img src="/images/logos/logo.png" alt={SITE.name} width="150" height="38" />
    </a>

    <nav class="nav-desktop" aria-label={locale === 'en' ? 'Main navigation' : 'Navegación principal'}>
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={['nav-link', { 'is-active': isActive(item.base) }]}
            aria-current={isActive(item.base) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="actions">
      <LanguageSwitcher locale={locale} path={currentPath} />
      <a class="panel-link" href={SITE.panelUrl} rel="noopener external">{tr('nav.login')}</a>
      <a class="cta" href={`mailto:${email}`}>{tr('nav.contact')}</a>
    </div>

    <details class="nav-mobile">
      <summary aria-label={tr('nav.menu')}><span></span><span></span></summary>
      <nav aria-label={locale === 'en' ? 'Mobile navigation' : 'Navegación móvil'}>
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <LanguageSwitcher locale={locale} path={currentPath} />
        <a href={SITE.panelUrl} rel="noopener external">{tr('nav.loginPanel')}</a>
        <a href={`mailto:${email}`}>{tr('nav.contact')}</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--ink) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    min-height: 4.5rem;
  }

  .brand img {
    height: 2.1rem;
    width: auto;
  }

  .nav-desktop {
    display: none;
    align-items: center;
    gap: var(--space-4);
    margin-inline: auto;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--steel);
    padding-block: 0.25rem;
    border-bottom: 1px solid transparent;
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--text);
    border-bottom-color: var(--signal);
  }

  .actions {
    display: none;
    align-items: center;
    gap: var(--space-4);
    margin-left: auto;
  }

  .panel-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--steel);
  }

  .panel-link:hover {
    color: var(--signal);
  }

  .cta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--signal);
    padding: 0.6rem 1rem;
    border-radius: var(--radius);
  }

  .cta:hover {
    background: var(--signal-strong);
  }

  .nav-mobile {
    margin-left: auto;
  }

  .nav-mobile summary {
    list-style: none;
    cursor: pointer;
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-content: center;
    gap: 6px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }

  .nav-mobile summary span {
    display: block;
    width: 1.25rem;
    height: 2px;
    background: var(--text);
  }

  .nav-mobile nav {
    position: absolute;
    inset-inline: 0;
    top: 4.5rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5) var(--space-5);
    background: var(--panel);
    border-bottom: 1px solid var(--line);
  }

  .nav-mobile nav a {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding-block: 0.5rem;
    color: var(--steel);
  }

  .nav-mobile nav a:last-child {
    color: var(--signal);
  }

  @media (min-width: 900px) {
    .nav-desktop,
    .actions {
      display: flex;
    }

    .nav-mobile {
      display: none;
    }
  }
</style>
