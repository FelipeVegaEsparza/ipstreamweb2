---
import Icon from './ui/Icon.astro';
import OnAirBadge from './ui/OnAirBadge.astro';

interface Props {
  url: string;
  title: string;
  description: string;
  station: string;
  meta: string;
  play: string;
  pause: string;
  connecting: string;
  error: string;
  open: string;
  live: string;
}

const {
  url,
  title,
  description,
  station,
  meta,
  play,
  pause,
  connecting,
  error,
  open,
  live,
} = Astro.props;

const bars = Array.from({ length: 32 }, (_, index) => {
  const value =
    Math.abs(Math.sin(index * 0.58) * 0.48) +
    Math.abs(Math.sin(index * 0.21) * 0.32) +
    Math.abs(Math.sin(index * 1.33) * 0.2);
  return Math.round((0.18 + Math.min(value, 1) * 0.82) * 100) / 100;
});
---

<div
  class="live-demo"
  data-live-demo
  data-play-label={play}
  data-pause-label={pause}
  data-connecting-label={connecting}
  data-error-label={error}
>
  <div class="live-demo__copy">
    <h2>{title}</h2>
    <p class="live-demo__desc">{description}</p>
    <div class="live-demo__actions">
      <button type="button" class="live-demo__play" data-live-toggle aria-pressed="false">
        <span class="live-demo__icon live-demo__icon--play" aria-hidden="true">
          <Icon name="play" size={16} />
        </span>
        <span class="live-demo__icon live-demo__icon--pause" aria-hidden="true">
          <Icon name="pause" size={16} />
        </span>
        <span data-live-label>{play}</span>
      </button>
      <a class="live-demo__open" href={url} target="_blank" rel="noopener">
        {open}
        <Icon name="external" size={13} />
      </a>
    </div>
    <p class="live-demo__status" data-live-status role="status" aria-live="polite"></p>
  </div>

  <div class="live-demo__player">
    <div class="live-demo__player-head">
      <div class="live-demo__station">
        <span class="live-demo__station-name">{station}</span>
        <span class="live-demo__station-meta mono">{meta}</span>
      </div>
      <OnAirBadge label={live} />
    </div>
    <div class="live-demo__wave" aria-hidden="true">
      {bars.map((height, index) => (
        <span style={`--i:${index};--h:${height}`} />
      ))}
    </div>
  </div>

  <audio data-live-audio preload="none" src={url}></audio>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-live-demo]').forEach((root) => {
    const audio = root.querySelector<HTMLAudioElement>('[data-live-audio]');
    const button = root.querySelector<HTMLButtonElement>('[data-live-toggle]');
    const label = root.querySelector<HTMLElement>('[data-live-label]');
    const status = root.querySelector<HTMLElement>('[data-live-status]');
    if (!audio || !button || !label) return;

    const playLabel = root.dataset.playLabel ?? 'Play';
    const pauseLabel = root.dataset.pauseLabel ?? 'Pause';
    const connectingLabel = root.dataset.connectingLabel ?? 'Connecting…';
    const errorLabel = root.dataset.errorLabel ?? 'Could not connect';

    const render = (playing: boolean, message = '') => {
      root.classList.toggle('is-playing', playing);
      button.setAttribute('aria-pressed', playing ? 'true' : 'false');
      button.disabled = false;
      label.textContent = playing ? pauseLabel : playLabel;
      if (status) status.textContent = message;
    };

    button.addEventListener('click', async () => {
      if (!audio.paused) {
        audio.pause();
        render(false);
        return;
      }

      render(false, connectingLabel);
      button.disabled = true;
      try {
        await audio.play();
      } catch {
        render(false, errorLabel);
      } finally {
        button.disabled = false;
      }
    });

    audio.addEventListener('playing', () => render(true));
    audio.addEventListener('pause', () => render(false));
    audio.addEventListener('waiting', () => {
      if (status) status.textContent = connectingLabel;
    });
    audio.addEventListener('error', () => render(false, errorLabel));
  });
</script>

<style>
  .live-demo {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .live-demo__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    max-width: 38rem;
    min-width: 0;
  }

  .live-demo h2 {
    max-width: 18ch;
    font-stretch: 112%;
    font-size: clamp(1.75rem, 1rem + 2.5vw, 2.75rem);
  }

  .live-demo__desc {
    max-width: 48ch;
    color: var(--steel);
  }

  .live-demo__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-1);
  }

  .live-demo__play {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: 0 var(--space-5);
    border: 1px solid var(--signal);
    border-radius: var(--radius);
    background: var(--signal);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .live-demo__play:hover {
    background: var(--signal-strong);
    border-color: var(--signal-strong);
  }

  .live-demo__play:disabled {
    opacity: 0.7;
    cursor: wait;
  }

  .live-demo__icon {
    display: inline-flex;
  }

  .live-demo__icon--pause {
    display: none;
  }

  .live-demo.is-playing .live-demo__icon--play {
    display: none;
  }

  .live-demo.is-playing .live-demo__icon--pause {
    display: inline-flex;
  }

  .live-demo__open {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--steel);
    text-transform: uppercase;
  }

  .live-demo__open:hover {
    color: var(--signal);
  }

  .live-demo__status {
    min-height: 1.25rem;
    font-size: 0.8125rem;
    color: var(--steel);
  }

  .live-demo__player {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    min-width: 0;
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--ink);
  }

  .live-demo__player-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .live-demo__station {
    min-width: 0;
  }

  .live-demo__station-name {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1rem + 1vw, 1.4rem);
    font-weight: 600;
    color: var(--text);
  }

  .live-demo__station-meta {
    display: block;
    margin-top: var(--space-1);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: var(--steel);
  }

  .live-demo__wave {
    display: flex;
    align-items: center;
    gap: 2px;
    height: clamp(4rem, 8vw, 6rem);
  }

  .live-demo__wave span {
    flex: 1 1 0;
    height: calc(var(--h, 0.5) * 100%);
    min-height: 2px;
    border-radius: 1px;
    background: var(--signal-gradient-v);
    opacity: 0.68;
  }

  .live-demo.is-playing .live-demo__wave span {
    animation: live-wave 1.4s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.06s);
  }

  @keyframes live-wave {
    0%,
    100% {
      transform: scaleY(0.72);
    }
    50% {
      transform: scaleY(1);
    }
  }

  @media (min-width: 980px) {
    .live-demo {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
      gap: var(--space-8);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .live-demo.is-playing .live-demo__wave span {
      animation: none;
    }
  }
</style>
