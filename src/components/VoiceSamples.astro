---
import Icon from './ui/Icon.astro'

interface VoiceSample {
  title: string
  description: string
  voice: string
  tag: string
  duration: string
  audioUrl: string
  transcript?: string
}

interface Props {
  eyebrow: string
  title: string
  description: string
  samples: VoiceSample[]
  playLabel: string
  pauseLabel: string
  transcriptLabel: string
  ariaLabel: string
}

const {
  eyebrow,
  title,
  description,
  samples,
  playLabel,
  pauseLabel,
  transcriptLabel,
  ariaLabel,
} = Astro.props

const waveBarsFor = (seed: number) =>
  Array.from({ length: 28 }, (_, index) => {
    const value =
      Math.abs(Math.sin((index + seed) * 0.7) * 0.5) +
      Math.abs(Math.sin((index + seed) * 0.23) * 0.3) +
      0.15
    return Math.round(Math.min(value, 1) * 100) / 100
  })
---

<section class="band band--panel voice-section" aria-label={ariaLabel}>
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
      <p class="muted">{description}</p>
    </div>

    <div
      class="voice-grid"
      data-voice-samples
      data-play-label={playLabel}
      data-pause-label={pauseLabel}
    >
      {
        samples.map((sample, index) => (
          <article class="voice-card" data-voice-sample data-duration={sample.duration}>
            <div class="voice-card__meta">
              <span class="mono voice-card__tag">{sample.tag}</span>
              <span class="mono voice-card__voice">{sample.voice}</span>
            </div>

            <h3>{sample.title}</h3>
            <p class="muted voice-card__desc">{sample.description}</p>

            <div class="voice-player">
              <button
                type="button"
                class="voice-player__toggle"
                data-voice-toggle
                data-title={sample.title}
                aria-label={`${playLabel}: ${sample.title}`}
                aria-pressed="false"
              >
                <span class="voice-player__icon voice-player__icon--play" aria-hidden="true">
                  <Icon name="play" size={15} />
                </span>
                <span class="voice-player__icon voice-player__icon--pause" aria-hidden="true">
                  <Icon name="pause" size={15} />
                </span>
              </button>

              <div class="voice-player__meter">
                <div class="voice-player__wave" aria-hidden="true">
                  {waveBarsFor(index + 1).map((height, barIndex) => (
                    <span
                      data-voice-bar
                      style={`--h:${height};--i:${barIndex}`}
                    />
                  ))}
                </div>
                <span class="mono voice-player__time" data-voice-time>{sample.duration}</span>
              </div>
            </div>

            {sample.transcript && (
              <details class="voice-card__transcript">
                <summary>{transcriptLabel}</summary>
                <p>“{sample.transcript}”</p>
              </details>
            )}

            <audio data-voice-audio preload="none" src={sample.audioUrl}></audio>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  function formatTime(seconds: number): string {
    if (!Number.isFinite(seconds) || seconds < 0) return '00:00'
    const total = Math.round(seconds)
    const minutes = Math.floor(total / 60)
    const rest = total % 60
    return `${String(minutes).padStart(2, '0')}:${String(rest).padStart(2, '0')}`
  }

  document.querySelectorAll<HTMLElement>('[data-voice-samples]').forEach((root) => {
    const playLabel = root.dataset.playLabel ?? 'Play'
    const pauseLabel = root.dataset.pauseLabel ?? 'Pause'
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-voice-sample]'))
    const players = cards
      .map((card) => {
        const audio = card.querySelector<HTMLAudioElement>('[data-voice-audio]')
        const button = card.querySelector<HTMLButtonElement>('[data-voice-toggle]')
        const bars = Array.from(card.querySelectorAll<HTMLElement>('[data-voice-bar]'))
        const time = card.querySelector<HTMLElement>('[data-voice-time]')
        if (!audio || !button || bars.length === 0 || !time) return null
        return { card, audio, button, bars, time, title: button.dataset.title ?? '' }
      })
      .filter((player): player is NonNullable<typeof player> => Boolean(player))

    const resetBars = (player: (typeof players)[number]) => {
      for (const bar of player.bars) bar.classList.remove('is-played')
    }

    const render = (player: (typeof players)[number], playing: boolean) => {
      player.card.classList.toggle('is-playing', playing)
      player.button.setAttribute('aria-pressed', playing ? 'true' : 'false')
      player.button.setAttribute(
        'aria-label',
        `${playing ? pauseLabel : playLabel}: ${player.title}`
      )
    }

    for (const player of players) {
      player.button.addEventListener('click', async () => {
        if (!player.audio.paused) {
          player.audio.pause()
          return
        }
        for (const other of players) {
          if (other !== player) other.audio.pause()
        }
        try {
          await player.audio.play()
        } catch {
          render(player, false)
        }
      })

      player.audio.addEventListener('play', () => render(player, true))
      player.audio.addEventListener('pause', () => render(player, false))
      player.audio.addEventListener('ended', () => {
        render(player, false)
        resetBars(player)
        player.time.textContent = player.card.dataset.duration ?? player.time.textContent
      })
      player.audio.addEventListener('timeupdate', () => {
        const duration = Number.isFinite(player.audio.duration) ? player.audio.duration : 0
        const ratio = duration > 0 ? player.audio.currentTime / duration : 0
        const active = Math.round(Math.min(1, Math.max(0, ratio)) * player.bars.length)
        player.bars.forEach((bar, index) => {
          bar.classList.toggle('is-played', index < active)
        })
        player.time.textContent = `${formatTime(player.audio.currentTime)} / ${formatTime(duration)}`
      })
    }
  })
</script>

<style>
  .voice-grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
  }

  .voice-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--panel-2);
  }

  .voice-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .voice-card__tag,
  .voice-card__voice {
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .voice-card__tag {
    color: var(--signal);
  }

  .voice-card__voice {
    color: var(--steel);
  }

  .voice-card h3 {
    font-size: 1.125rem;
  }

  .voice-card__desc {
    font-size: 0.9375rem;
  }

  .voice-player {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-4);
  }

  .voice-player__toggle {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--signal);
    border-radius: 50%;
    background: var(--signal);
    color: var(--ink);
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .voice-player__toggle:hover {
    background: var(--signal-strong);
    border-color: var(--signal-strong);
  }

  .voice-player__icon {
    display: inline-flex;
  }

  .voice-player__icon--pause {
    display: none;
  }

  .voice-card.is-playing .voice-player__icon--play {
    display: none;
  }

  .voice-card.is-playing .voice-player__icon--pause {
    display: inline-flex;
  }

  .voice-player__meter {
    display: flex;
    flex: 1;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
  }

  .voice-player__wave {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 2px;
    height: 2.25rem;
  }

  .voice-player__wave span {
    flex: 1 1 0;
    height: calc(var(--h, 0.5) * 100%);
    min-height: 2px;
    border-radius: 1px;
    background: color-mix(in srgb, var(--signal) 18%, var(--line));
    transition: background-color 0.15s ease;
  }

  .voice-player__wave span.is-played {
    background: var(--signal-gradient-v);
  }

  .voice-card.is-playing .voice-player__wave span {
    animation: voice-wave 1.3s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.045s);
  }

  .voice-player__time {
    flex: 0 0 auto;
    font-size: 0.625rem;
    color: var(--steel);
    font-variant-numeric: tabular-nums;
  }

  .voice-card__transcript {
    margin-top: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }

  .voice-card__transcript summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    cursor: pointer;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--steel);
  }

  .voice-card__transcript summary::-webkit-details-marker {
    display: none;
  }

  .voice-card__transcript summary::after {
    content: '+';
    color: var(--signal);
    font-size: 0.875rem;
    line-height: 1;
  }

  .voice-card__transcript[open] summary::after {
    content: '−';
  }

  .voice-card__transcript p {
    margin-top: var(--space-3);
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--steel);
  }

  @keyframes voice-wave {
    0%,
    100% {
      transform: scaleY(0.72);
    }
    50% {
      transform: scaleY(1);
    }
  }

  @media (min-width: 720px) {
    .voice-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .voice-card.is-playing .voice-player__wave span {
      animation: none;
    }

    .voice-player__wave span,
    .voice-player__toggle {
      transition: none;
    }
  }
</style>
