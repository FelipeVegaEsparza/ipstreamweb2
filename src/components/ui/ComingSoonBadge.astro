---
interface Props {
  label?: string;
  overlay?: boolean;
}

const { label = 'PRÓXIMAMENTE', overlay = false } = Astro.props;
---

<span class:list={['soon', 'mono', { 'soon--overlay': overlay }]}>
  <span class="soon__dot" aria-hidden="true"></span>
  <span>{label}</span>
</span>

<style>
  .soon {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border: 1px dashed var(--line-paper);
    border-radius: var(--radius-sm);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--steel);
    vertical-align: middle;
  }

  .soon__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--steel);
  }

  .soon--overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-4deg);
    gap: var(--space-4);
    padding: var(--space-4) var(--space-7);
    border: 2px solid var(--signal);
    border-radius: var(--radius);
    font-size: clamp(1.125rem, 0.5rem + 2.4vw, 2.25rem);
    letter-spacing: 0.3em;
    color: var(--signal-strong);
    background: color-mix(in srgb, var(--ink) 78%, transparent);
    backdrop-filter: blur(3px);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--signal) 14%, transparent);
    text-align: center;
    white-space: nowrap;
    animation: soon-pulse 2.4s ease-in-out infinite;
  }

  .soon--overlay .soon__dot {
    width: 0.75rem;
    height: 0.75rem;
    background: var(--signal);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--signal) 22%, transparent);
    animation: pulse 2.4s ease-in-out infinite;
  }

  @keyframes soon-pulse {
    0%,
    100% {
      transform: translate(-50%, -50%) rotate(-4deg) scale(1);
      box-shadow: 0 0 0 6px color-mix(in srgb, var(--signal) 14%, transparent);
    }
    50% {
      transform: translate(-50%, -50%) rotate(-4deg) scale(1.04);
      box-shadow: 0 0 0 12px color-mix(in srgb, var(--signal) 6%, transparent);
    }
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .soon--overlay {
      animation: none;
    }

    .soon--overlay .soon__dot {
      animation: none;
    }
  }
</style>
