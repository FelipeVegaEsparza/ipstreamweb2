---
interface Props {
  from?: number;
  to?: number;
  step?: number;
  unit?: string;
}

const { from = 88, to = 108, step = 2, unit = 'FM' } = Astro.props;
const ticks: number[] = [];
for (let value = from; value <= to + 0.0001; value += step) {
  ticks.push(Math.round(value * 10) / 10);
}
---

<div class="freq" aria-hidden="true">
  {ticks.map((value, index) => (
    <span class="freq__tick">
      <span class="freq__mark" />
      <span class:list={['freq__num', 'mono', { 'is-major': index % 5 === 0 }]}>{value}</span>
    </span>
  ))}
  <span class="freq__unit mono">{unit}</span>
</div>

<style>
  .freq {
    display: flex;
    align-items: flex-end;
    gap: var(--space-4);
    border-bottom: 1px solid var(--line);
    padding-bottom: var(--space-2);
    overflow: hidden;
  }

  .freq__tick {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
  }

  .freq__mark {
    width: 1px;
    height: 8px;
    background: var(--line);
  }

  .freq__tick:nth-child(5n + 1) .freq__mark {
    height: 14px;
    background: var(--steel);
  }

  .freq__num {
    font-size: 0.625rem;
    color: var(--steel);
  }

  .freq__num.is-major {
    color: var(--signal);
  }

  .freq__unit {
    margin-left: auto;
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    color: var(--steel);
  }
</style>
