---
interface Props {
  label?: string;
  tone?: 'signal' | 'danger';
}

const { label = 'ON AIR', tone = 'signal' } = Astro.props;
---

<span class:list={['onair', `onair--${tone}`]}>
  <span class="dot" aria-hidden="true"></span>
  <span class="label">{label}</span>
</span>

<style>
  .onair {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.02);
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.24em;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 3px rgba(53, 214, 208, 0.18);
    animation: pulse 2.4s ease-in-out infinite;
  }

  .onair--danger .dot {
    background: var(--danger);
    box-shadow: 0 0 0 3px rgba(255, 91, 74, 0.18);
  }

  .onair--signal .label {
    color: var(--signal);
  }

  .onair--danger .label {
    color: var(--danger);
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dot {
      animation: none;
    }
  }
</style>
