---
interface Props {
  bars?: number;
  height?: number;
  animated?: boolean;
  class?: string;
}

const { bars = 56, height = 48, animated = false, class: className = '' } = Astro.props;

const levels = Array.from({ length: bars }, (_, i) => {
  const wave = Math.sin(i * 0.55) * 0.5 + Math.sin(i * 0.19) * 0.35 + Math.sin(i * 1.3) * 0.15;
  return Math.round((0.3 + Math.abs(wave) * 0.7) * 100) / 100;
});
---

<div
  class:list={['wave', { 'wave--animated': animated }, className]}
  style={`--wave-height:${height}px`}
  role="img"
  aria-label="Forma de onda de audio"
>
  {levels.map((level) => <span class="bar" style={`--level:${level}`} />)}
</div>

<style>
  .wave {
    display: flex;
    align-items: center;
    gap: 2px;
    height: var(--wave-height, 48px);
  }

  .bar {
    flex: 1 1 auto;
    height: calc(var(--level) * 100%);
    min-height: 3px;
    background: var(--signal-gradient-v);
    border-radius: 1px;
    opacity: 0.85;
  }

  .wave--animated .bar {
    animation: meter 1.6s ease-in-out infinite;
    animation-delay: calc(var(--level) * -1.2s);
  }

  @keyframes meter {
    0%,
    100% {
      transform: scaleY(0.72);
    }
    50% {
      transform: scaleY(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wave--animated .bar {
      animation: none;
    }
  }
</style>
