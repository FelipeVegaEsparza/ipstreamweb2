---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getDatabase } from '../lib/db/client';
import { getSocialLinks } from '../lib/db/repositories/settings';
import { DEFAULT_SEO, getPageSeo, getSeoSettings, type SeoSettings } from '../lib/seo';
import { getLocale } from '../lib/i18n';
import { SITE } from '../lib/site';
import { getSiteContent } from '../lib/panel-content';

interface Props {
  title: string;
  description?: string;
  canonical?: string | URL;
  image?: string;
  noindex?: boolean;
  social?: Record<string, string> | null;
  seo?: SeoSettings | null;
  page?: string;
}

const { social: socialProp, seo: seoProp, page, ...rest } = Astro.props;
const locale = getLocale(Astro.locals);
const panelContent = await getSiteContent(locale);
const useDatabase = socialProp === undefined;
const db = useDatabase ? getDatabase() : null;
const panelSocial = Object.fromEntries(
  Object.entries(panelContent.global.social).filter(([, value]) => Boolean(value))
);
const social = { ...(db ? getSocialLinks(db) : socialProp ?? {}), ...panelSocial };
const seo = seoProp ?? (db ? getSeoSettings(db) : DEFAULT_SEO);
const pageSeo = db && page ? getPageSeo(db, page) : null;
const sameAs = social ? Object.values(social).filter((value) => value && value !== '#') : [];

const PAGE_SEO_KEYS: Record<string, { title: string; description: string }> = {
  home: { title: 'home.metaTitle', description: 'home.metaDescription' },
  ia: { title: 'ia.metaTitle', description: 'ia.metaDescription' },
  caracteristicas: { title: 'features.metaTitle', description: 'features.metaDescription' },
  planes: { title: 'plans.metaTitle', description: 'plans.metaDescription' },
  clientes: { title: 'clients.metaTitle', description: 'clients.metaDescription' },
  tutoriales: { title: 'tutorials.metaTitle', description: 'tutorials.metaDescription' },
  noticias: { title: 'news.metaTitle', description: 'news.metaDescription' },
};
const pageSeoKeys = page ? PAGE_SEO_KEYS[page] : null;
const panelTitle = pageSeoKeys ? panelContent.i18n[pageSeoKeys.title] : undefined;
const panelDescription = pageSeoKeys ? panelContent.i18n[pageSeoKeys.description] : undefined;

const title = panelTitle || pageSeo?.title || rest.title;
const description = panelDescription || pageSeo?.description || rest.description;
const image = pageSeo?.image || rest.image;
const noindex = rest.noindex || pageSeo?.noindex || false;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  noindex={noindex}
  canonical={rest.canonical}
  seo={seo}
  sameAs={sameAs}
>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <Header email={panelContent.global.contactEmail || SITE.email} />
  <main id="contenido"><slot /></main>
  <Footer social={social} email={panelContent.global.contactEmail || SITE.email} />
</BaseLayout>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: -3rem;
    z-index: 100;
    background: var(--signal);
    color: var(--ink);
    padding: 0.5rem 1rem;
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    transition: top 0.15s ease;
  }

  .skip-link:focus {
    top: var(--space-4);
  }
</style>
