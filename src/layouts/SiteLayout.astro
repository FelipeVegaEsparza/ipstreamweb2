---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getDatabase } from '../lib/db/client';
import { getSocialLinks } from '../lib/db/repositories/settings';
import { DEFAULT_SEO, getPageSeo, getSeoSettings, type SeoSettings } from '../lib/seo';
import { getLocale } from '../lib/i18n';
import { SITE } from '../lib/site';
import { getSiteContent } from '../lib/panel-content';
import '../styles/scroll-driven.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string | URL;
  image?: string;
  noindex?: boolean;
  social?: Record<string, string> | null;
  seo?: SeoSettings | null;
  page?: string;
}

const { social: socialProp, seo: seoProp, page, ...rest } = Astro.props;
const locale = getLocale(Astro.locals);
const panelContent = await getSiteContent(locale);
const useDatabase = socialProp === undefined;
const db = useDatabase ? getDatabase() : null;
const panelSocial = Object.fromEntries(
  Object.entries(panelContent.global.social).filter(([, value]) => Boolean(value))
);
const social = { ...(db ? getSocialLinks(db) : socialProp ?? {}), ...panelSocial };
const seo = seoProp ?? (db ? getSeoSettings(db) : DEFAULT_SEO);
const pageSeo = db && page ? getPageSeo(db, page) : null;
const sameAs = social ? Object.values(social).filter((value) => value && value !== '#') : [];

const PAGE_SEO_KEYS: Record<string, { title: string; description: string }> = {
  home: { title: 'home.metaTitle', description: 'home.metaDescription' },
  ia: { title: 'ia.metaTitle', description: 'ia.metaDescription' },
  caracteristicas: { title: 'features.metaTitle', description: 'features.metaDescription' },
  planes: { title: 'plans.metaTitle', description: 'plans.metaDescription' },
  clientes: { title: 'clients.metaTitle', description: 'clients.metaDescription' },
  tutoriales: { title: 'tutorials.metaTitle', description: 'tutorials.metaDescription' },
  noticias: { title: 'news.metaTitle', description: 'news.metaDescription' },
};
const pageSeoKeys = page ? PAGE_SEO_KEYS[page] : null;
const panelTitle = pageSeoKeys ? panelContent.i18n[pageSeoKeys.title] : undefined;
const panelDescription = pageSeoKeys ? panelContent.i18n[pageSeoKeys.description] : undefined;

const title = panelTitle || pageSeo?.title || rest.title;
const description = panelDescription || pageSeo?.description || rest.description;
const image = pageSeo?.image || rest.image;
const noindex = rest.noindex || pageSeo?.noindex || false;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  noindex={noindex}
  canonical={rest.canonical}
  seo={seo}
  sameAs={sameAs}
>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <Header email={panelContent.global.contactEmail || SITE.email} />
  <main
    id="contenido"
    class:list={['site-scroll', { 'site-scroll--deck': page === 'home' }]}
  ><slot /></main>
  <Footer social={social} email={panelContent.global.contactEmail || SITE.email} />
  <script>
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const supportsScrollTimeline =
      typeof CSS !== 'undefined' && CSS.supports('animation-timeline: view()')

    if (document.querySelector('.site-scroll--deck')) {
      document.documentElement.classList.add('site-deck')
    }

    if (!prefersReduced && !supportsScrollTimeline && 'IntersectionObserver' in window) {
      const root = document.documentElement
      root.classList.add('scroll-fallback')

      const revealSelector = [
        '.site-scroll .band:not(.hero):not(.hero-band) .section-head',
        '.site-scroll .band:not(.hero):not(.hero-band) .module',
        '.site-scroll .voice-card',
        '.site-scroll .client',
        '.site-scroll .news-card',
        '.site-scroll .tutorial-row',
        '.site-scroll .highlight-row',
        '.site-scroll .measure-card',
        '.site-scroll .related-item',
        '.site-scroll .step',
        '.site-scroll .pro-item',
        '.site-scroll .player',
        '.site-scroll .live-demo',
        '.site-scroll .studio',
        '.site-scroll .chat-feature',
        '.site-scroll .contact-grid',
        '.site-scroll .ai-plan',
        '.site-scroll .ai-plan-note',
        '.site-scroll .cta',
        '.site-scroll .cta-inner',
        '.site-scroll .plans-more',
        '.site-scroll .ai-more',
        '.site-scroll .more',
        '.site-scroll .empty',
        '.site-scroll .plans-empty',
      ].join(',')

      const elements = Array.from(document.querySelectorAll(revealSelector))
      elements.forEach((element) => element.classList.add('sd-reveal'))

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue
            entry.target.classList.add('sd-visible')
            observer.unobserve(entry.target)
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
      )

      elements.forEach((element) => observer.observe(element))

      const updateProgress = () => {
        const max = root.scrollHeight - window.innerHeight
        root.style.setProperty(
          '--sd-scroll-progress',
          String(max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0)
        )
      }

      updateProgress()
      window.addEventListener('scroll', updateProgress, { passive: true })
      window.addEventListener('resize', updateProgress)
    }
  </script>
  <script>
    const analyticsEnabled =
      !navigator.webdriver &&
      navigator.doNotTrack !== '1' &&
      (navigator as Navigator & { globalPrivacyControl?: boolean }).globalPrivacyControl !== true

    if (analyticsEnabled) {
      const storageGet = (storage: Storage, key: string): string | null => {
        try {
          return storage.getItem(key)
        } catch {
          return null
        }
      }
      const storageSet = (storage: Storage, key: string, value: string): void => {
        try {
          storage.setItem(key, value)
        } catch {}
      }
      const randomId = (): string =>
        typeof crypto.randomUUID === 'function'
          ? crypto.randomUUID()
          : `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 12)}`

      const VISITOR_KEY = 'cf_vid'
      const SESSION_KEY = 'cf_sid'
      const SESSION_TS_KEY = 'cf_sid_ts'
      const SESSION_TTL = 30 * 60 * 1000

      let visitorId = storageGet(localStorage, VISITOR_KEY)
      if (!visitorId) {
        visitorId = randomId()
        storageSet(localStorage, VISITOR_KEY, visitorId)
      }

      let sessionId = storageGet(sessionStorage, SESSION_KEY)
      const lastActivity = Number(storageGet(sessionStorage, SESSION_TS_KEY) || 0)
      if (!sessionId || !lastActivity || Date.now() - lastActivity > SESSION_TTL) {
        sessionId = randomId()
        storageSet(sessionStorage, SESSION_KEY, sessionId)
      }
      storageSet(sessionStorage, SESSION_TS_KEY, String(Date.now()))

      const pageviewId = randomId()
      const path = window.location.pathname
      const startedAt = Date.now()
      const params = new URLSearchParams(window.location.search)
      let maxScrollDepth = 0
      let pageLeft = false

      const send = (payload: Record<string, unknown>): void => {
        const body = JSON.stringify(payload)
        try {
          if (typeof navigator.sendBeacon === 'function') {
            const blob = new Blob([body], { type: 'application/json' })
            if (navigator.sendBeacon('/api/analytics/collect', blob)) return
          }
          void fetch('/api/analytics/collect', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body,
            keepalive: true,
          }).catch(() => {})
        } catch {}
      }

      const base = () => ({
        sessionId,
        visitorId,
        pageviewId,
        path,
        locale: document.documentElement.lang === 'en' ? 'en' : 'es',
        screenWidth: window.screen?.width,
        screenHeight: window.screen?.height,
        utmSource: params.get('utm_source') || undefined,
        utmMedium: params.get('utm_medium') || undefined,
        utmCampaign: params.get('utm_campaign') || undefined,
      })

      send({
        type: 'pageview',
        ...base(),
        title: document.title,
        referrer: document.referrer,
      })

      const updateScroll = () => {
        const total = document.documentElement.scrollHeight - window.innerHeight
        const depth = total > 0 ? (window.scrollY / total) * 100 : 100
        maxScrollDepth = Math.max(maxScrollDepth, Math.min(100, Math.round(depth)))
      }

      let scrollScheduled = false
      window.addEventListener(
        'scroll',
        () => {
          if (scrollScheduled) return
          scrollScheduled = true
          requestAnimationFrame(() => {
            updateScroll()
            scrollScheduled = false
          })
        },
        { passive: true }
      )
      updateScroll()

      const sectionSlug = (value: string): string =>
        value
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '')

      const sectionElements = Array.from(
        document.querySelectorAll<HTMLElement>('main.site-scroll .band')
      ).filter((element) => !element.parentElement?.closest('.band'))
      const activeSections = new Map<
        HTMLElement,
        { key: string; label: string; startedAt: number; maxRatio: number }
      >()

      const sectionInfo = (section: HTMLElement, index: number) => {
        const heading = section.querySelector('h1, h2')?.textContent?.trim() || ''
        const attr = section.getAttribute('data-analytics-section') || ''
        const label = heading || attr || `Sección ${index + 1}`
        const key = attr || section.id || sectionSlug(heading) || `section-${index + 1}`
        return { key, label }
      }

      const flushSection = (section: HTMLElement) => {
        const data = activeSections.get(section)
        if (!data) return
        activeSections.delete(section)
        send({
          type: 'section',
          ...base(),
          sectionKey: data.key,
          sectionLabel: data.label,
          durationMs: Math.min(Date.now() - data.startedAt, 30 * 60 * 1000),
          maxVisibleRatio: data.maxRatio,
        })
      }

      if ('IntersectionObserver' in window) {
        const sectionObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              const section = entry.target as HTMLElement
              const index = sectionElements.indexOf(section)
              const info = sectionInfo(section, index)
              const active = activeSections.get(section)

              if (entry.isIntersecting) {
                if (active) {
                  active.maxRatio = Math.max(active.maxRatio, entry.intersectionRatio)
                } else {
                  activeSections.set(section, {
                    ...info,
                    startedAt: Date.now(),
                    maxRatio: entry.intersectionRatio,
                  })
                }
              } else if (active) {
                active.maxRatio = Math.max(active.maxRatio, entry.intersectionRatio)
                flushSection(section)
              }
            }
          },
          { threshold: [0, 0.25, 0.5, 0.75, 1], rootMargin: '0px 0px -8% 0px' }
        )
        sectionElements.forEach((section) => sectionObserver.observe(section))
      }

      const leave = () => {
        if (pageLeft) return
        pageLeft = true
        updateScroll()
        activeSections.forEach((_, section) => flushSection(section))
        send({
          type: 'pageleave',
          ...base(),
          durationMs: Date.now() - startedAt,
          maxScrollDepth,
        })
      }

      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden') leave()
      })
      window.addEventListener('pagehide', leave)

      document.addEventListener('click', (event) => {
        const target = event.target as Element | null
        const element = target?.closest<HTMLElement>('a, button')
        if (!element || element.closest('header, footer')) return

        const href = element instanceof HTMLAnchorElement ? element.getAttribute('href') || '' : ''
        const planModule = element.closest<HTMLElement>('.module')
        const planActions = planModule?.querySelector('.plan-actions') ?? null
        const isPlanAction = Boolean(planActions)
        const isPlanDemo =
          isPlanAction && planActions
            ? Array.from(planActions.querySelectorAll('a, button')).indexOf(element) > 0
            : false
        const planName =
          (isPlanAction ? planModule?.querySelector('h3')?.textContent?.trim() : '') ||
          element.textContent?.trim().replace(/\s+/g, ' ').slice(0, 80) ||
          ''

        let name: string | null = null
        let label = planName

        if (isPlanAction) {
          name = isPlanDemo ? 'plan_demo' : 'plan_click'
        } else if (href.includes('/planes/')) {
          name = 'plan_click'
        } else if (href.includes('/planes')) {
          name = 'cta_planes'
        } else if (href.includes('/ia')) {
          name = 'cta_ia'
        } else if (href.includes('/registro') || href.includes('panel.casterfly.com')) {
          name = 'cta_registro'
        } else if (href.startsWith('mailto:')) {
          name = 'cta_email'
        } else if (href.includes('wa.me') || href.includes('whatsapp')) {
          name = 'cta_whatsapp'
        } else if (element.matches('[data-live-toggle]')) {
          name = 'demo_play'
        } else if (element.matches('[data-voice-toggle]')) {
          name = 'voice_play'
        }

        if (!name) return
        send({
          type: 'event',
          ...base(),
          name,
          label: label || undefined,
        })
      })

      document.addEventListener('submit', (event) => {
        const form = event.target as HTMLFormElement | null
        if (!form?.matches('.contact-form')) return
        send({
          type: 'event',
          ...base(),
          name: 'contact_submit',
          label: 'Formulario de contacto',
        })
      })
    }
  </script>
</BaseLayout>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: -3rem;
    z-index: 100;
    background: var(--signal);
    color: var(--ink);
    padding: 0.5rem 1rem;
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    transition: top 0.15s ease;
  }

  .skip-link:focus {
    top: var(--space-4);
  }
</style>
