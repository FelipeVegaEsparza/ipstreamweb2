---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getDatabase } from '../lib/db/client';
import { getSocialLinks } from '../lib/db/repositories/settings';

interface Props {
  title: string;
  description?: string;
  canonical?: string | URL;
  image?: string;
  noindex?: boolean;
  social?: Record<string, string> | null;
}

const { social: socialProp, ...baseProps } = Astro.props;
const social = socialProp === undefined ? getSocialLinks(getDatabase()) : socialProp;
---

<BaseLayout {...baseProps}>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <Header />
  <main id="contenido"><slot /></main>
  <Footer social={social} />
</BaseLayout>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: -3rem;
    z-index: 100;
    background: var(--signal);
    color: var(--ink);
    padding: 0.5rem 1rem;
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    transition: top 0.15s ease;
  }

  .skip-link:focus {
    top: var(--space-4);
  }
</style>
