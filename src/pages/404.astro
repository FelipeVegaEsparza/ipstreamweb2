---
import SiteLayout from '../layouts/SiteLayout.astro';
import ConsoleButton from '../components/ui/ConsoleButton.astro';
import OnAirBadge from '../components/ui/OnAirBadge.astro';
import Waveform from '../components/ui/Waveform.astro';
import HeroBackground from '../components/HeroBackground.astro';
import { getLocale, localizedPath, t } from '../lib/i18n';

const locale = getLocale(Astro.locals);
const tr = t(locale);
---

<SiteLayout title={tr('notFound.metaTitle')} description={tr('notFound.metaDescription')} noindex social={null}>
  <section class="band band--dark hero-band">
    <HeroBackground />
    <div class="container notfound">
      <OnAirBadge label={tr('notFound.badge')} tone="danger" />
      <p class="code mono">ERROR 404</p>
      <h1 class="display">{tr('notFound.title')}</h1>
      <p class="muted">{tr('notFound.text')}</p>
      <Waveform bars={40} />
      <div class="actions">
        <ConsoleButton href={localizedPath(locale, '/')}>{tr('notFound.back')}</ConsoleButton>
        <ConsoleButton variant="ghost" href={localizedPath(locale, '/planes')}>{tr('notFound.plans')}</ConsoleButton>
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .notfound {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    max-width: 44rem;
  }

  .code {
    font-size: 0.875rem;
    letter-spacing: 0.4em;
    color: var(--signal);
  }

  .notfound h1 {
    font-size: clamp(2rem, 1.2rem + 4vw, 3.5rem);
  }

  .notfound :global(.wave) {
    width: 100%;
    max-width: 22rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
</style>
