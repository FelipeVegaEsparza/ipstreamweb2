---
import AdminLayout from '../../layouts/AdminLayout.astro';
import ResultMessage from '../../components/admin/ResultMessage.astro';
import { actions } from 'astro:actions';
import { getDatabase } from '../../lib/db/client';
import { listCategories } from '../../lib/db/repositories/plans';
import { getAdminContext } from '../../lib/admin';

const { csrf } = getAdminContext(Astro);
const db = getDatabase();
const categories = listCategories(db);
const editId = Number(Astro.url.searchParams.get('id')) || null;
const editing = editId ? categories.find((category) => category.id === editId) ?? null : null;
const result = Astro.getActionResult(actions.planCategory);
---

<AdminLayout title="Categorías de planes">
  <ResultMessage result={result} />

  <div class="admin-card">
    <h2>{editing ? `Editar: ${editing.name}` : 'Nueva categoría'}</h2>
    <form method="POST" action={actions.planCategory} class="form-grid">
      <input type="hidden" name="csrf" value={csrf} />
      <input type="hidden" name="intent" value={editing ? 'update' : 'create'} />
      {editing && <input type="hidden" name="id" value={editing.id} />}

      <div class="field">
        <label for="name">Nombre</label>
        <input class="input" id="name" name="name" value={editing?.name ?? ''} required />
      </div>
      <div class="field">
        <label for="slug">Slug</label>
        <input class="input" id="slug" name="slug" value={editing?.slug ?? ''} />
      </div>
      <div class="field">
        <label for="displayOrder">Orden</label>
        <input class="input" id="displayOrder" name="displayOrder" type="number" value={editing?.displayOrder ?? 0} />
      </div>
      <div class="field field--full">
        <label for="description">Descripción</label>
        <textarea class="textarea" id="description" name="description">{editing?.description ?? ''}</textarea>
      </div>
      <div class="field field--full">
        <button class="btn-admin btn-admin--primary" type="submit">{editing ? 'Guardar cambios' : 'Crear categoría'}</button>
      </div>
    </form>
    {editing && <p class="hint" style="margin-top: 1rem;"><a href="/admin/categorias">Cancelar edición</a></p>}
  </div>

  <div class="admin-card">
    <h2>Categorías ({categories.length})</h2>
    <table class="admin-table">
      <thead><tr><th>Nombre</th><th>Slug</th><th>Orden</th><th>Estado</th><th>Acciones</th></tr></thead>
      <tbody>
        {categories.map((category) => (
          <tr>
            <td><strong>{category.name}</strong></td>
            <td class="mono muted">{category.slug}</td>
            <td class="mono">{category.displayOrder}</td>
            <td><span class:list={['badge', { 'badge--on': category.isActive }]}>{category.isActive ? 'Activo' : 'Inactivo'}</span></td>
            <td>
              <div class="admin-actions">
                <a class="btn-admin" href={`/admin/categorias?id=${category.id}`}>Editar</a>
                <form method="POST" action={actions.planCategory}>
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="intent" value="toggle" />
                  <input type="hidden" name="id" value={category.id} />
                  <input type="hidden" name="isActive" value={category.isActive ? 'false' : 'true'} />
                  <button class="btn-admin" type="submit">{category.isActive ? 'Desactivar' : 'Activar'}</button>
                </form>
                <form method="POST" action={actions.planCategory}>
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="intent" value="delete" />
                  <input type="hidden" name="id" value={category.id} />
                  <button class="btn-admin btn-admin--danger" type="submit">Eliminar</button>
                </form>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AdminLayout>
