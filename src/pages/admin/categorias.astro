---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { SITE } from '../../lib/site';
---

<AdminLayout title="Categorías de planes">
  <div class="admin-card">
    <h2>Las categorías de planes ahora viven en el dashboard</h2>
    <p class="muted">
      El sitio público ya no administra planes ni categorías locales. La fuente de verdad es la
      sección <strong>Planes y Pagos</strong> del dashboard de CasterFly.
    </p>
    <p style="margin-top: 1rem;">
      <a class="btn-admin btn-admin--primary" href={`${SITE.panelUrl}admin/billing`} target="_blank" rel="noopener">
        Abrir Planes y Pagos en el dashboard
      </a>
    </p>
  </div>
</AdminLayout>
