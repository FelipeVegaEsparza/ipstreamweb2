---
import AdminLayout from '../../layouts/AdminLayout.astro';
import ResultMessage from '../../components/admin/ResultMessage.astro';
import { actions } from 'astro:actions';
import { getDatabase } from '../../lib/db/client';
import { listCommunity } from '../../lib/db/repositories/community';
import { getAdminContext } from '../../lib/admin';

const { csrf } = getAdminContext(Astro);
const db = getDatabase();
const items = listCommunity(db);
const editId = Number(Astro.url.searchParams.get('id')) || null;
const editing = editId ? items.find((item) => item.id === editId) ?? null : null;
const result = Astro.getActionResult(actions.community);
---

<AdminLayout title="Comunidad">
  <ResultMessage result={result} />

  <div class="admin-card">
    <h2>{editing ? `Editar: ${editing.name}` : 'Nueva radio'}</h2>
    <form method="POST" action={actions.community} enctype="multipart/form-data" class="form-grid">
      <input type="hidden" name="csrf" value={csrf} />
      <input type="hidden" name="intent" value={editing ? 'update' : 'create'} />
      {editing && <input type="hidden" name="id" value={editing.id} />}
      {editing?.logoUrl && <input type="hidden" name="logoUrl" value={editing.logoUrl} />}

      <div class="field">
        <label for="name">Nombre</label>
        <input class="input" id="name" name="name" value={editing?.name ?? ''} required />
      </div>
      <div class="field">
        <label for="siteUrl">Sitio web</label>
        <input class="input" id="siteUrl" name="siteUrl" value={editing?.siteUrl ?? ''} required />
      </div>
      <div class="field">
        <label for="displayOrder">Orden</label>
        <input class="input" id="displayOrder" name="displayOrder" type="number" value={editing?.displayOrder ?? 0} />
      </div>
      <div class="field">
        <label for="image">Logo</label>
        <input class="input" id="image" name="image" type="file" accept="image/*" />
      </div>
      <div class="field field--full">
        <label for="description">Descripción</label>
        <textarea class="textarea" id="description" name="description">{editing?.description ?? ''}</textarea>
      </div>
      <label class="checkbox">
        <input type="checkbox" name="isActive" value="true" checked={editing ? editing.isActive : true} />
        Activa (visible en el sitio)
      </label>
      <div class="field field--full">
        <button class="btn-admin btn-admin--primary" type="submit">{editing ? 'Guardar' : 'Crear radio'}</button>
      </div>
    </form>
    {editing && <p class="hint" style="margin-top: 1rem;"><a href="/admin/comunidad">Cancelar</a></p>}
  </div>

  <div class="admin-card">
    <h2>Radios ({items.length})</h2>
    <table class="admin-table">
      <thead><tr><th>Logo</th><th>Nombre</th><th>Sitio</th><th>Estado</th><th>Acciones</th></tr></thead>
      <tbody>
        {items.map((item) => (
          <tr>
            <td>{item.logoUrl ? <img src={item.logoUrl} alt="" /> : <span class="muted">—</span>}</td>
            <td><strong>{item.name}</strong></td>
            <td class="mono muted">{item.siteUrl}</td>
            <td><span class:list={['badge', { 'badge--on': item.isActive }]}>{item.isActive ? 'Activa' : 'Inactiva'}</span></td>
            <td>
              <div class="admin-actions">
                <a class="btn-admin" href={`/admin/comunidad?id=${item.id}`}>Editar</a>
                <form method="POST" action={actions.community}>
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="intent" value="toggle" />
                  <input type="hidden" name="id" value={item.id} />
                  <input type="hidden" name="isActive" value={item.isActive ? 'false' : 'true'} />
                  <button class="btn-admin" type="submit">{item.isActive ? 'Desactivar' : 'Activar'}</button>
                </form>
                <form method="POST" action={actions.community}>
                  <input type="hidden" name="csrf" value={csrf} />
                  <input type="hidden" name="intent" value="delete" />
                  <input type="hidden" name="id" value={item.id} />
                  <button class="btn-admin btn-admin--danger" type="submit">Eliminar</button>
                </form>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AdminLayout>
