---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroBackground from '../../components/HeroBackground.astro';
import { actions } from 'astro:actions';
import { SESSION_COOKIE, credentialsConfigured, verifySessionToken } from '../../lib/auth';
import '../../styles/admin.css';

const token = Astro.cookies.get(SESSION_COOKIE)?.value;
if (verifySessionToken(token, Astro.request.headers.get('user-agent'))) {
  return Astro.redirect('/admin');
}

const result = Astro.getActionResult(actions.login);
if (result?.data?.ok) {
  return Astro.redirect('/admin');
}

const error = result?.error?.message;
const configured = credentialsConfigured();
---

<BaseLayout title="Ingresar — Panel IPStream" noindex>
  <div class="login-wrap">
    <HeroBackground />
    <div class="login-card">
      <img src="/images/logos/logo.png" alt="IPStream" width="150" height="38" />
      <p class="login-eyebrow">[ Acceso interno ]</p>
      <h1 class="display">Panel de administración</h1>

      {
        !configured ? (
          <div class="msg msg--error">
            El panel no está configurado: faltan las variables ADMIN_USER y ADMIN_PASS.
          </div>
        ) : (
          <>
            {error && <div class="msg msg--error">{error}</div>}
            <form method="POST" action={actions.login} class="login-form">
              <div class="field">
                <label for="username">Usuario</label>
                <input class="input" type="text" name="username" id="username" autocomplete="username" required />
              </div>
              <div class="field">
                <label for="password">Contraseña</label>
                <input class="input" type="password" name="password" id="password" autocomplete="current-password" required />
              </div>
              <button class="btn-admin btn-admin--primary" type="submit">Acceder al panel</button>
            </form>
          </>
        )
      }

      <p class="back"><a class="mono" href="/">← Volver al sitio</a></p>
    </div>
  </div>
</BaseLayout>

<style>
  .login-wrap {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: var(--space-5);
    background: var(--ink);
  }

  .login-card {
    position: relative;
    z-index: 1;
    width: min(100%, 26rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    background: color-mix(in srgb, var(--panel) 94%, transparent);
    backdrop-filter: blur(6px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-7);
    box-shadow: var(--shadow-panel);
  }

  .login-card img {
    margin-bottom: var(--space-2);
  }

  .login-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--signal);
  }

  .login-card h1 {
    font-size: 1.5rem;
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .login-form .btn-admin {
    justify-content: center;
    margin-top: var(--space-2);
  }

  .back {
    font-size: 0.75rem;
  }

  .back a {
    color: var(--steel);
  }
</style>
