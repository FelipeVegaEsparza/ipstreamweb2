---
import AdminLayout from '../../layouts/AdminLayout.astro';
import ResultMessage from '../../components/admin/ResultMessage.astro';
import { actions } from 'astro:actions';
import { getDatabase } from '../../lib/db/client';
import { getSocialLinks, SOCIAL_KEYS } from '../../lib/db/repositories/settings';
import { getAdminContext } from '../../lib/admin';
import { SOCIAL_LABELS } from '../../lib/site';

const { csrf } = getAdminContext(Astro);
const db = getDatabase();
const social = getSocialLinks(db);
const result = Astro.getActionResult(actions.settings);
---

<AdminLayout title="Redes sociales">
  <ResultMessage result={result} />

  <div class="admin-card">
    <h2>Enlaces del sitio</h2>
    <p class="hint">Estos enlaces aparecen en el pie del sitio público.</p>
    <form method="POST" action={actions.settings} class="form-grid" style="margin-top: 1rem;">
      <input type="hidden" name="csrf" value={csrf} />
      {
        SOCIAL_KEYS.map((key) => (
          <div class="field field--full">
            <label for={key}>{SOCIAL_LABELS[key] ?? key}</label>
            <input class="input" id={key} name={key} value={social[key]} placeholder="https://..." />
          </div>
        ))
      }
      <div class="field field--full">
        <button class="btn-admin btn-admin--primary" type="submit">Guardar redes</button>
      </div>
    </form>
  </div>
</AdminLayout>
