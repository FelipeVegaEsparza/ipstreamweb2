---
import SiteLayout from '../layouts/SiteLayout.astro';
import ConsoleButton from '../components/ui/ConsoleButton.astro';
import Module from '../components/ui/Module.astro';
import Icon from '../components/ui/Icon.astro';
import FrequencyStrip from '../components/ui/FrequencyStrip.astro';
import PlayerCard from '../components/PlayerCard.astro';
import HeroBackground from '../components/HeroBackground.astro';
import { getContent } from '../lib/content-i18n';
import { getLocale, localizedPath, t } from '../lib/i18n';

const locale = getLocale(Astro.locals);
const tr = t(locale);
const { PILLARS, HIGHLIGHTS, STUDIO_FEATURES, PLAYERS, AI_FEATURES } = getContent(locale);

---

<SiteLayout
  page="caracteristicas"
  title={tr('features.metaTitle')}
  description={tr('features.metaDescription')}
>
  <section class="band band--dark hero-band">
    <HeroBackground />
    <div class="container">
      <p class="eyebrow">{tr('features.hero.eyebrow')}</p>
      <h1 class="display">{tr('features.hero.title')}</h1>
      <p class="lede muted">{tr('features.hero.description')}</p>
      <div class="freq-wrap"><FrequencyStrip /></div>
    </div>
  </section>

  <section class="band band--paper" id="ia">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{tr('features.ai.eyebrow')}</p>
        <h2>{tr('features.ai.title')}</h2>
        <p class="muted">{tr('features.ai.description')}</p>
      </div>
      <div class="grid-3">
        {
          AI_FEATURES.map((feature) => (
            <Module label={`${locale === 'en' ? 'AI' : 'IA'} ${feature.code}`} icon={feature.icon} led="signal">
              <h3>{feature.title}</h3>
              <p class="muted">{feature.description}</p>
              <ul class="points">{feature.points.map((point) => <li>{point}</li>)}</ul>
            </Module>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band band--panel" id="sitio-web">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{tr('features.base.eyebrow')}</p>
        <h2>{tr('features.base.title')}</h2>
      </div>
      <div class="grid-3">
        {
          PILLARS.map((pillar) => (
            <Module label={`${tr('home.channel')} ${pillar.code}`} icon={pillar.icon} led="signal">
              <h3>{pillar.title}</h3>
              <p class="muted">{pillar.description}</p>
              <ul class="points">{pillar.points.map((point) => <li>{point}</li>)}</ul>
            </Module>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band band--paper">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{tr('features.highlights.eyebrow')}</p>
        <h2>{tr('features.highlights.title')}</h2>
      </div>
      <div class="grid-3">
        {
          HIGHLIGHTS.map((item) => (
            <article class="highlight">
              <div class="highlight__head">
                <span class="highlight__icon">
                  <Icon name={item.icon ?? 'play'} size={22} />
                </span>
                <span class="mono code">{item.code}</span>
              </div>
              <h3>{item.title}</h3>
              <p class="muted">{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band band--dark" id="casterfly-studio">
    <div class="container studio">
      <div>
        <p class="eyebrow">{tr('features.studio.eyebrow')}</p>
        <h2 class="display">{tr('features.studio.title')}</h2>
        <p class="muted">{tr('features.studio.description')}</p>
        <div class="studio-grid">
          {
            STUDIO_FEATURES.map((feature) => (
              <div>
                <span class="mono code">{feature.code}</span>
                <h3>{feature.title}</h3>
                <p class="muted">{feature.description}</p>
              </div>
            ))
          }
        </div>
      </div>
      <div class="studio-screen">
        <img
          src="/images/estudio/consola-en-vivo.png"
          alt={tr('home.studio.alt')}
          width="1600"
          height="1300"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="band band--panel">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{tr('features.players.eyebrow')}</p>
        <h2>{tr('features.players.title')}</h2>
      </div>
      <div class="players">
        {
          PLAYERS.map((player, index) => (
            <PlayerCard code={String(index + 1).padStart(2, '0')} {...player} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="band band--dark">
    <div class="container cta">
      <h2 class="display">{tr('features.cta.title')}</h2>
      <ConsoleButton href={localizedPath(locale, '/planes')}>{tr('features.cta.button')}</ConsoleButton>
    </div>
  </section>
</SiteLayout>

<style>
  .lede {
    margin-top: var(--space-4);
    max-width: 40rem;
  }

  .freq-wrap {
    margin-top: var(--space-7);
  }

  .grid-3 {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .points {
    list-style: none;
    padding: 0;
    margin-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .points li {
    font-size: 0.8125rem;
    color: var(--steel);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.2rem 0.5rem;
  }

  .highlight {
    display: flex;
    flex-direction: column;
    border-top: 2px solid var(--line-paper);
    padding-top: var(--space-5);
    transition: border-color 0.15s ease;
  }

  .highlight:hover {
    border-top-color: var(--signal);
  }

  .highlight__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .highlight__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--line-paper);
    border-radius: var(--radius);
    color: var(--signal);
    background: color-mix(in srgb, var(--signal) 7%, transparent);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .highlight:hover .highlight__icon {
    border-color: color-mix(in srgb, var(--signal) 45%, var(--line-paper));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--signal) 12%, transparent);
  }

  .highlight h3 {
    margin-block: 0 var(--space-2);
  }

  .code {
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    color: var(--muted-on-paper);
  }

  .studio {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  .studio h2 {
    margin-block: var(--space-3);
  }

  .studio-grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    margin-top: var(--space-6);
  }

  .studio img {
    width: 100%;
    height: auto;
  }

  .studio-screen {
    position: relative;
    display: block;
    line-height: 0;
  }

  .players {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  @media (min-width: 900px) {
    .studio {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
</style>
