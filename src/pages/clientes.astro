---
import SiteLayout from '../layouts/SiteLayout.astro';
import OnAirBadge from '../components/ui/OnAirBadge.astro';
import HeroBackground from '../components/HeroBackground.astro';
import Icon from '../components/ui/Icon.astro';
import { getDatabase } from '../lib/db/client';
import { listPortfolio } from '../lib/db/repositories/portfolio';
import { getLocale, t } from '../lib/i18n';

const locale = getLocale(Astro.locals);
const tr = t(locale);
const db = getDatabase();
const clients = listPortfolio(db, { activeOnly: true });
---

<SiteLayout page="clientes" title={tr('clients.metaTitle')} description={tr('clients.metaDescription')}>
  <section class="band band--dark hero-band">
    <HeroBackground />
    <div class="container">
      <p class="eyebrow">{tr('clients.hero.eyebrow')}</p>
      <h1 class="display">{tr('clients.hero.title')}</h1>
      <p class="lede muted">{tr('clients.hero.description')}</p>
    </div>
  </section>

  <section class="band band--panel">
    <div class="container">
      {
        clients.length === 0 ? (
          <div class="empty">
            <OnAirBadge label={tr('common.noSignal')} tone="danger" />
            <h2>{tr('clients.empty.title')}</h2>
          </div>
        ) : (
          <div class="clients">
            {clients.map((client) => {
              const href = client.projectUrl ?? undefined;
              return (
                <a
                  class="client"
                  href={href ?? '#'}
                  target={href ? '_blank' : undefined}
                  rel={href ? 'noopener external' : undefined}
                >
                  <div class="client-media">
                    {client.imageUrl ? (
                      <img src={client.imageUrl} alt={client.title} loading="lazy" />
                    ) : (
                      <span class="placeholder" aria-hidden="true" />
                    )}
                  </div>
                  <div class="client-body">
                    <div class="client-head">
                      <h2>{client.title}</h2>
                      {href && (
                        <span class="client-arrow" aria-hidden="true">
                          <Icon name="external" size={16} />
                        </span>
                      )}
                    </div>
                    {client.description && <p class="muted">{client.description}</p>}
                  </div>
                </a>
              );
            })}
          </div>
          <p class="note muted">{tr('clients.note')}</p>
        )
      }
    </div>
  </section>
</SiteLayout>

<style>
  .lede {
    margin-top: var(--space-4);
  }

  .clients {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
  }

  @media (min-width: 900px) {
    .clients {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .client {
    display: grid;
    grid-template-columns: 1fr;
    overflow: hidden;
    background: var(--panel-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    transition: border-color 0.18s ease;
  }

  .client:hover {
    border-color: var(--signal);
  }

  .client-media {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    padding: var(--space-5);
    background: var(--ink);
    border-bottom: 1px solid var(--line);
  }

  .client-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .placeholder {
    width: 100%;
    height: 100%;
    border-radius: var(--radius);
    background: var(--panel);
  }

  .client-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    flex: 1 1 auto;
  }

  .client-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .client-head h2 {
    font-size: 1.125rem;
  }

  .client-arrow {
    display: inline-flex;
    color: var(--steel);
    transition: color 0.18s ease, transform 0.18s ease;
  }

  .client:hover .client-arrow {
    color: var(--signal);
    transform: translate(2px, -2px);
  }

  .client-body p {
    font-size: 0.9375rem;
  }

  .note {
    margin-top: var(--space-6);
    font-size: 0.875rem;
  }

  @media (min-width: 720px) {
    .client {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }

    .client-media {
      aspect-ratio: auto;
      min-height: 190px;
      border-right: 1px solid var(--line);
      border-bottom: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .client,
    .client-arrow {
      transition: none;
    }
  }

  .empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }
</style>
