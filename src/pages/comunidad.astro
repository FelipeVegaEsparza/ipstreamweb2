---
import SiteLayout from '../layouts/SiteLayout.astro';
import OnAirBadge from '../components/ui/OnAirBadge.astro';
import HeroBackground from '../components/HeroBackground.astro';
import { getDatabase } from '../lib/db/client';
import { listCommunity } from '../lib/db/repositories/community';

const db = getDatabase();
const radios = listCommunity(db, { activeOnly: true });
---

<SiteLayout page="comunidad" title="Comunidad — IPStream" description="Radios y proyectos de la comunidad IPStream. Visita sus sitios y conoce sus propuestas.">
  <section class="band band--dark hero-band">
    <HeroBackground />
    <div class="container">
      <p class="eyebrow">[ COMUNIDAD ]</p>
      <h1 class="display">Radios de la comunidad</h1>
      <p class="lede muted">Proyectos que emiten con IPStream. Visítalos y conoce sus propuestas.</p>
    </div>
  </section>

  <section class="band band--panel">
    <div class="container">
      {
        radios.length === 0 ? (
          <div class="empty">
            <OnAirBadge label="SIN SEÑAL" tone="danger" />
            <h2>Pronto sumaremos más radios</h2>
          </div>
        ) : (
          <div class="radios">
            {radios.map((radio) => (
              <article class="radio">
                <div class="radio-media">
                  {radio.logoUrl ? (
                    <img src={radio.logoUrl} alt={radio.name} width="240" height="135" loading="lazy" />
                  ) : (
                    <span class="placeholder mono">{radio.name.slice(0, 1).toUpperCase()}</span>
                  )}
                </div>
                <div class="radio-body">
                  <h2>{radio.name}</h2>
                  {radio.description && <p class="muted">{radio.description}</p>}
                  <a class="visit mono" href={radio.siteUrl} target="_blank" rel="noopener external">Visitar sitio</a>
                </div>
              </article>
            ))}
          </div>
        )
      }
    </div>
  </section>
</SiteLayout>

<style>
  .lede {
    margin-top: var(--space-4);
  }

  .radios {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .radio {
    display: flex;
    flex-direction: column;
    background: var(--panel-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .radio-media {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    background: var(--ink);
    border-bottom: 1px solid var(--line);
    padding: var(--space-5);
  }

  .radio-media img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .placeholder {
    font-size: 2.5rem;
    color: var(--signal);
  }

  .radio-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    flex: 1 1 auto;
  }

  .radio-body h2 {
    font-size: 1.25rem;
  }

  .radio-body p {
    font-size: 0.9375rem;
    flex: 1 1 auto;
  }

  .visit {
    align-self: flex-start;
    margin-top: var(--space-2);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--signal);
  }

  .visit:hover {
    color: var(--signal-strong);
  }

  .empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }
</style>
