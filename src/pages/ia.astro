---
import SiteLayout from '../layouts/SiteLayout.astro';
import HeroBackground from '../components/HeroBackground.astro';
import ConsoleButton from '../components/ui/ConsoleButton.astro';
import Module from '../components/ui/Module.astro';
import Icon from '../components/ui/Icon.astro';
import OnAirBadge from '../components/ui/OnAirBadge.astro';
import FrequencyStrip from '../components/ui/FrequencyStrip.astro';
import { createSiteTranslator, getSiteContent } from '../lib/panel-content';
import { getLocale, localizedPath } from '../lib/i18n';
import { getPanelPlans } from '../lib/panel-plans';

const locale = getLocale(Astro.locals);
const content = await getSiteContent(locale);
const tr = createSiteTranslator(locale, content.i18n);
const { aiFeatures: AI_FEATURES, aiSteps: AI_STEPS, proFeatures: PRO_FEATURES } = content.collections;
const plans = await getPanelPlans(locale);
const aiPlans = plans.filter((plan) => plan.aiLiveEnabled);
const aiPlan = aiPlans[0] ?? null;
const aiPlanName = aiPlan?.name ?? tr('ia.plans.planFallback');
const aiCharacters = aiPlan?.aiMonthlyCharacters ?? 50000;
const aiMusicMinutes = aiPlan?.aiMusicMinutes ?? 10;
const formattedCharacters = aiCharacters.toLocaleString(locale === 'en' ? 'en-US' : 'es-CL');
---

<SiteLayout
  page="ia"
  title={tr('ia.metaTitle')}
  description={tr('ia.metaDescription')}
>
  <section class="band band--dark hero-band">
    <HeroBackground />
    <div class="container hero">
      <div class="hero-copy">
        <p class="eyebrow">{tr('ia.hero.eyebrow')}</p>
        <h1 class="display">{tr('ia.hero.title')}</h1>
        <p class="lede muted">{tr('ia.hero.description')}</p>
        <div class="hero-actions">
          <ConsoleButton href={localizedPath(locale, '/planes')}>{tr('ia.hero.ctaPlans')}</ConsoleButton>
          <ConsoleButton variant="ghost" href={localizedPath(locale, '/caracteristicas')}>{tr('ia.hero.ctaFeatures')}</ConsoleButton>
        </div>
        <div class="freq-wrap"><FrequencyStrip /></div>
      </div>

      <Module label={tr('ia.console.label')} icon="mic" led="signal" class="ai-console">
        <div class="console-top">
          <OnAirBadge label={tr('ia.console.onAir')} />
          <span class="mono console-code">PRO</span>
        </div>
        <p class="console-title">{tr('ia.console.title')}</p>
        <ul class="console-list">
          <li><span class="mono">01</span> {tr('ia.console.item1')}</li>
          <li><span class="mono">02</span> {tr('ia.console.item2')}</li>
          <li><span class="mono">03</span> {tr('ia.console.item3')}</li>
          <li><span class="mono">04</span> {tr('ia.console.item4')}</li>
        </ul>
        <div class="console-foot">
          <span>{aiPlanName}</span>
          <span class="mono">{tr('ia.console.characters', { count: formattedCharacters })}</span>
          <span class="mono">{tr('ia.console.music', { minutes: aiMusicMinutes })}</span>
        </div>
      </Module>
    </div>
  </section>

  <section class="band band--panel">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{tr('ia.features.eyebrow')}</p>
        <h2>{tr('ia.features.title')}</h2>
        <p class="muted">{tr('ia.features.description')}</p>
      </div>
      <div class="grid-3">
        {
          AI_FEATURES.map((feature) => (
            <Module label={`${locale === 'en' ? 'AI' : 'IA'} ${feature.code}`} icon={feature.icon} led="signal">
              <h3>{feature.title}</h3>
              <p class="muted">{feature.description}</p>
              <ul class="points">{feature.points.map((point) => <li>{point}</li>)}</ul>
            </Module>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band band--paper">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{tr('ia.steps.eyebrow')}</p>
        <h2>{tr('ia.steps.title')}</h2>
      </div>
      <div class="steps">
        {
          AI_STEPS.map((step) => (
            <article class="step">
              <span class="mono step-code">{step.code}</span>
              <h3>{step.title}</h3>
              <p class="muted">{step.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band band--dark">
    <div class="container pro">
      <div>
        <p class="eyebrow">{tr('ia.pro.eyebrow')}</p>
        <h2 class="display">{tr('ia.pro.title')}</h2>
        <p class="muted">{tr('ia.pro.description')}</p>
        <div class="pro-list">
          {
            PRO_FEATURES.map((feature) => (
              <div class="pro-item">
                <span class="pro-icon"><Icon name={feature.icon} size={18} /></span>
                <div>
                  <h3>{feature.title}</h3>
                  <p class="muted">{feature.text}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
      <Module label={tr('ia.pro.moduleLabel')} icon="dashboard" led="ok" class="pro-module">
        <p class="mono pro-kicker">{tr('ia.pro.kicker')}</p>
        <h3 class="pro-title">{tr('ia.pro.moduleTitle')}</h3>
        <p class="muted">{tr('ia.pro.moduleDescription')}</p>
        <div class="pro-tags">
          <span>{tr('ia.pro.tag1')}</span>
          <span>{tr('ia.pro.tag2')}</span>
          <span>{tr('ia.pro.tag3')}</span>
          <span>{tr('ia.pro.tag4')}</span>
        </div>
        <ConsoleButton href={localizedPath(locale, '/planes')}>{tr('ia.pro.cta')}</ConsoleButton>
      </Module>
    </div>
  </section>

  <section class="band band--panel">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{tr('ia.plans.eyebrow')}</p>
        <h2>{tr('ia.plans.title')}</h2>
        <p class="muted">{tr('ia.plans.description')}</p>
      </div>
      <div class="ai-plan">
        <div>
          <span class="mono ai-plan-code">[ IA EN VIVO ]</span>
          <h3>{aiPlanName}</h3>
          <p class="muted">{tr('ia.plans.planDescription')}</p>
        </div>
        <div class="ai-plan-metrics">
          <div><strong class="mono">{formattedCharacters}</strong><span>{tr('ia.plans.characters', { count: '' }).replace('{count}', '').trim()}</span></div>
          <div><strong class="mono">{aiMusicMinutes}</strong><span>{tr('ia.plans.music', { minutes: '' }).replace('{minutes}', '').trim()}</span></div>
        </div>
        <ConsoleButton href={localizedPath(locale, '/planes')}>{tr('ia.plans.cta')}</ConsoleButton>
      </div>
    </div>
  </section>

  <section class="band band--dark">
    <div class="container cta">
      <div>
        <p class="eyebrow">{tr('ia.cta.eyebrow')}</p>
        <h2 class="display">{tr('ia.cta.title')}</h2>
        <p class="muted">{tr('ia.cta.description')}</p>
      </div>
      <ConsoleButton href={localizedPath(locale, '/planes')}>{tr('ia.cta.button')}</ConsoleButton>
    </div>
  </section>
</SiteLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  .hero h1 {
    font-size: clamp(2.75rem, 1.2rem + 6vw, 5.5rem);
    margin-top: var(--space-4);
  }

  .lede {
    margin-top: var(--space-4);
    max-width: 38rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .freq-wrap {
    margin-top: var(--space-7);
  }

  .ai-console {
    align-self: stretch;
  }

  .console-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .console-code {
    color: var(--signal);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
  }

  .console-title {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1rem + 1.5vw, 2rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: var(--space-5);
  }

  .console-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .console-list li {
    display: flex;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
    color: var(--text);
    font-size: 0.9375rem;
  }

  .console-list li span {
    color: var(--signal);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    padding-top: 0.2rem;
  }

  .console-foot {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    color: var(--steel);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
  }

  .console-foot span:first-child {
    color: var(--text);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .grid-3 {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .grid-3 h3 {
    margin-bottom: var(--space-2);
  }

  .points {
    list-style: none;
    padding: 0;
    margin-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .points li {
    font-size: 0.8125rem;
    color: var(--steel);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.2rem 0.5rem;
  }

  .steps {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .step {
    border-top: 2px solid var(--line-paper);
    padding-top: var(--space-4);
  }

  .step-code {
    color: var(--muted-on-paper);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
  }

  .step h3 {
    margin-block: var(--space-2) var(--space-2);
  }

  .pro {
    display: grid;
    gap: var(--space-8);
    align-items: start;
  }

  .pro h2 {
    margin-block: var(--space-3);
  }

  .pro-list {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .pro-item {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .pro-icon {
    display: grid;
    place-items: center;
    width: 2.35rem;
    height: 2.35rem;
    flex: 0 0 auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--signal);
    background: rgba(53, 214, 208, 0.06);
  }

  .pro-item h3 {
    margin-bottom: 0.2rem;
    font-size: 1rem;
  }

  .pro-item p {
    font-size: 0.875rem;
  }

  .pro-module {
    align-self: stretch;
  }

  .pro-kicker {
    color: var(--signal);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    margin-bottom: var(--space-4);
  }

  .pro-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.1rem + 2vw, 2.5rem);
    line-height: 1.05;
    margin-bottom: var(--space-4);
  }

  .pro-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block: var(--space-5);
  }

  .pro-tags span {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--steel);
  }

  .ai-plan {
    display: grid;
    gap: var(--space-5);
    align-items: center;
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--panel-2);
  }

  .ai-plan-code {
    color: var(--signal);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
  }

  .ai-plan h3 {
    margin-block: var(--space-2);
    font-size: 1.75rem;
  }

  .ai-plan-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }

  .ai-plan-metrics div {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-left: var(--space-4);
    border-left: 1px solid var(--line);
  }

  .ai-plan-metrics strong {
    font-size: 1.5rem;
    color: var(--signal);
  }

  .ai-plan-metrics span {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--steel);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  @media (min-width: 900px) {
    .hero,
    .pro {
      grid-template-columns: 1.1fr 0.9fr;
    }

    .ai-plan {
      grid-template-columns: 1.2fr 0.8fr auto;
    }
  }
</style>
