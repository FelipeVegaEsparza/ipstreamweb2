---
import SiteLayout from '../layouts/SiteLayout.astro';
import ConsoleButton from '../components/ui/ConsoleButton.astro';
import OnAirBadge from '../components/ui/OnAirBadge.astro';
import ComingSoonBadge from '../components/ui/ComingSoonBadge.astro';
import Module from '../components/ui/Module.astro';
import Icon from '../components/ui/Icon.astro';
import PlayerCard from '../components/PlayerCard.astro';
import HeroBackground from '../components/HeroBackground.astro';
import ContactSection from '../components/ContactSection.astro';
import { getDatabase } from '../lib/db/client';
import { listNews } from '../lib/db/repositories/news';
import { listPortfolio } from '../lib/db/repositories/portfolio';
import { getContent } from '../lib/content-i18n';
import { getLocale, localizedPath, t } from '../lib/i18n';
import { formatUSD, formatDateShort } from '../lib/format';
import { getPanelPlanGroups } from '../lib/panel-plans';

const locale = getLocale(Astro.locals);
const tr = t(locale);
const { PILLARS, HIGHLIGHTS, STUDIO_FEATURES, PLAYERS, AI_FEATURES } = getContent(locale);
const db = getDatabase();
const planGroups = await getPanelPlanGroups(locale);
const latestNews = listNews(db, { activeOnly: true, limit: 3 });
const clients = listPortfolio(db, { activeOnly: true }).slice(0, 8);
const carouselClients = [...clients, ...clients];

const minUsd = (group: (typeof planGroups)[number]) =>
  Math.min(...group.plans.map((plan) => plan.usdAmount));

const allPlans = planGroups.flatMap((group) => group.plans);
const aiPlan = allPlans.find((plan) => plan.aiLiveEnabled) ?? null;
const aiPlanName = aiPlan?.name ?? tr('ia.plans.planFallback');
const aiCharacters = aiPlan?.aiMonthlyCharacters ?? 50000;
const aiMusicMinutes = aiPlan?.aiMusicMinutes ?? 10;
---

<SiteLayout page="home" title={tr('home.metaTitle')} description={tr('home.metaDescription')}>
  <section class="hero band band--dark">
    <HeroBackground />
    <div class="container hero-grid">
      <div class="hero-copy">
        <OnAirBadge label={tr('home.hero.badge')} />
        <h1 class="display">{tr('home.hero.title')}</h1>
        <p class="lede">{tr('home.hero.description')}</p>
        <div class="hero-actions">
          <ConsoleButton href={localizedPath(locale, '/ia')}>{tr('home.hero.ctaAI')}</ConsoleButton>
          <ConsoleButton variant="ghost" href={localizedPath(locale, '/planes')}>{tr('home.hero.ctaPlans')}</ConsoleButton>
        </div>
      </div>

      <div class="hero-console">
        <Module label="AI / ON AIR" icon="mic" led="signal" class="hero-ai">
          <p class="mono hero-ai-kicker">{tr('home.hero.aiKicker')}</p>
          <h2 class="hero-ai-title">{tr('home.hero.aiTitle')}</h2>
          <ul class="hero-ai-list">
            <li><span class="mono">01</span> {tr('home.hero.aiItem1')}</li>
            <li><span class="mono">02</span> {tr('home.hero.aiItem2')}</li>
            <li><span class="mono">03</span> {tr('home.hero.aiItem3')}</li>
            <li><span class="mono">04</span> {tr('home.hero.aiItem4')}</li>
          </ul>
          <div class="hero-ai-foot">
            <span>{aiPlanName}</span>
            <span class="mono">{tr('home.hero.aiCharacters', { count: aiCharacters.toLocaleString(locale === 'en' ? 'en-US' : 'es-CL') })}</span>
          </div>
        </Module>
      </div>
    </div>
  </section>

  <section class="band band--paper" id="ia">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{tr('home.ai.eyebrow')}</p>
        <h2>{tr('home.ai.title')}</h2>
        <p class="muted">{tr('home.ai.description')}</p>
      </div>
      <div class="grid-3">
        {
          AI_FEATURES.slice(0, 6).map((feature) => (
            <Module label={`${locale === 'en' ? 'AI' : 'IA'} ${feature.code}`} icon={feature.icon} led="signal">
              <h3>{feature.title}</h3>
              <p class="muted">{feature.description}</p>
              <ul class="points">{feature.points.map((point) => <li>{point}</li>)}</ul>
            </Module>
          ))
        }
      </div>
      <div class="ai-more">
        <ConsoleButton href={localizedPath(locale, '/ia')}>{tr('home.ai.cta')}</ConsoleButton>
      </div>
    </div>
  </section>

  <section class="band band--panel">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{tr('home.platform.eyebrow')}</p>
        <h2>{tr('home.platform.title')}</h2>
        <p class="muted">{tr('home.platform.description')}</p>
      </div>
      <div class="grid-3">
        {
          PILLARS.map((pillar) => (
            <Module label={`${tr('home.channel')} ${pillar.code}`} icon={pillar.icon} led="signal">
              {pillar.image && (
                <div class="pillar-media">
                  <img src={pillar.image} alt={pillar.title} width="1440" height="771" loading="lazy" />
                </div>
              )}
              <h3>{pillar.title}</h3>
              <p class="muted">{pillar.description}</p>
              <ul class="points">
                {pillar.points.map((point) => <li>{point}</li>)}
              </ul>
            </Module>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band band--paper">
    <div class="container studio">
      <div class="studio-copy">
        <p class="eyebrow">{tr('home.studio.eyebrow')}</p>
        <h2 class="display">{tr('home.studio.title')}</h2>
        <p class="studio-lead muted">{tr('home.studio.description')}</p>
        <ul class="channels">
          {
            STUDIO_FEATURES.map((feature) => (
              <li class="channel">
                <span class="mono channel__idx">{feature.code}</span>
                <div class="channel__text">
                  <h3>{feature.title}</h3>
                  <p class="muted">{feature.description}</p>
                </div>
                <span class="channel__led" aria-hidden="true" />
              </li>
            ))
          }
        </ul>
      </div>

      <figure class="monitor">
        <span class="monitor__strip">
          <span class="mono monitor__name">CasterFly Studio</span>
          <OnAirBadge label="ON AIR" />
        </span>
        <div class="monitor__screen">
          <img
            src="/images/estudio/1.png"
            alt={tr('home.studio.alt')}
            width="1276"
            height="780"
            loading="lazy"
          />
          <ComingSoonBadge overlay label={tr('common.soon')} />
        </div>
        <figcaption class="monitor__foot">
          <span class="mono">24/7</span>
          <span class="mono">Auto-DJ</span>
          <span class="mono">{tr('home.studio.timeTemp')}</span>
          <span class="mono">{tr('home.studio.recording')}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="band band--dark">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{tr('home.highlights.eyebrow')}</p>
        <h2>{tr('home.highlights.title')}</h2>
      </div>
      <div class="grid-3">
        {
          HIGHLIGHTS.map((item) => (
            <article class="highlight">
              <div class="highlight__head">
                <span class="highlight__icon">
                  <Icon name={item.icon ?? 'play'} size={22} />
                </span>
                <span class="mono highlight-code">{item.code}</span>
              </div>
              <h3>{item.title}</h3>
              <p class="muted">{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band band--panel">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{tr('home.players.eyebrow')}</p>
        <h2>{tr('home.players.title')}</h2>
        <p class="muted">{tr('home.players.description')}</p>
      </div>
      <div class="players">
        {
          PLAYERS.map((player, index) => (
            <PlayerCard code={String(index + 1).padStart(2, '0')} {...player} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="band band--dark">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{tr('home.plans.eyebrow')}</p>
        <h2>{tr('home.plans.title')}</h2>
      </div>
      <div class="grid-3">
        {
          planGroups.map((group) => (
            <Module label={group.label} led="ok">
              <p class="muted">{group.description}</p>
              <p class="plan-from">
                {tr('home.plans.from')} <span class="mono">{formatUSD(minUsd(group))}</span>{tr('home.plans.perMonth')}
              </p>
              <ConsoleButton variant="ghost" href={localizedPath(locale, '/planes')}>{tr('home.plans.viewPlans', { count: group.plans.length })}</ConsoleButton>
            </Module>
          ))
        }
      </div>
      <div class="ai-plan-note">
        <div>
          <span class="mono">{tr('home.aiPlan.eyebrow')}</span>
          <strong>{aiPlanName}</strong>
          <span class="muted">{tr('home.aiPlan.characters', { count: aiCharacters.toLocaleString(locale === 'en' ? 'en-US' : 'es-CL'), minutes: aiMusicMinutes })}</span>
        </div>
        <ConsoleButton variant="ghost" href={localizedPath(locale, '/ia')}>{tr('home.aiPlan.cta')}</ConsoleButton>
      </div>
    </div>
  </section>

  {
    clients.length > 0 && (
      <section class="band band--panel">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">{tr('home.clients.eyebrow')}</p>
            <h2>{tr('home.clients.title')}</h2>
          </div>
          <div class="clients-viewport" data-carousel tabindex="0" role="region" aria-label={tr('home.clients.aria')}>
            <ul class="clients-track">
              {carouselClients.map((client, index) => {
                const isClone = index >= clients.length;
                return (
                  <li class="client-slide" aria-hidden={isClone ? 'true' : undefined}>
                    <a
                      class="client"
                      href={client.projectUrl ?? localizedPath(locale, '/clientes')}
                      target={client.projectUrl ? '_blank' : undefined}
                      rel="noopener"
                      tabindex={isClone ? -1 : undefined}
                    >
                      <span class="client-media">
                        {client.imageUrl ? (
                          <img src={client.imageUrl} alt={isClone ? '' : client.title} loading="lazy" />
                        ) : (
                          <span class="placeholder" aria-hidden="true" />
                        )}
                      </span>
                      <span class="client-name">{client.title}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        </div>
      </section>
    )
  }

  {
    latestNews.length > 0 && (
      <section class="band band--paper">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">{tr('home.news.eyebrow')}</p>
            <h2>{tr('home.news.title')}</h2>
          </div>
          <div class="grid-3">
            {latestNews.map((item) => (
              <article class="news-card">
                {item.image && <img src={item.image} alt={item.title} width="400" height="225" loading="lazy" />}
                <p class="mono news-date">{formatDateShort(item.publishedAt)}</p>
                <h3><a href={localizedPath(locale, `/noticias/${item.slug}`)}>{item.title}</a></h3>
                <p class="muted">{item.excerpt}</p>
              </article>
            ))}
          </div>
          <div class="more"><ConsoleButton variant="quiet" href={localizedPath(locale, '/noticias')}>{tr('home.news.viewAll')}</ConsoleButton></div>
        </div>
      </section>
    )
  }

  <ContactSection />

  <section class="band band--dark cta-band">
    <div class="container cta-inner">
      <div>
        <p class="eyebrow">{tr('home.cta.eyebrow')}</p>
        <h2 class="display">{tr('home.cta.title')}</h2>
      </div>
      <div class="hero-actions">
        <ConsoleButton href={localizedPath(locale, '/planes')}>{tr('home.cta.plans')}</ConsoleButton>
        <ConsoleButton variant="ghost" href="#contacto">{tr('home.cta.contact')}</ConsoleButton>
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((viewport) => {
    let paused = reduceMotion;
    let hovered = false;
    let resumeTimer: number | undefined;
    const pause = () => {
      paused = true;
      window.clearTimeout(resumeTimer);
    };
    const resume = () => {
      paused = false;
    };

    viewport.addEventListener('mouseenter', () => {
      hovered = true;
      pause();
    });
    viewport.addEventListener('mouseleave', () => {
      hovered = false;
      resume();
    });
    viewport.addEventListener('focusin', pause);
    viewport.addEventListener('focusout', resume);
    viewport.addEventListener('pointerdown', pause);
    viewport.addEventListener('pointerup', () => {
      window.clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(() => {
        if (!hovered) resume();
      }, 2000);
    });

    if (!reduceMotion) {
      const tick = () => {
        const loopPoint = viewport.scrollWidth / 2;
        if (!paused && loopPoint > viewport.clientWidth) {
          viewport.scrollLeft += 0.6;
          if (viewport.scrollLeft >= loopPoint) viewport.scrollLeft -= loopPoint;
        }
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    }
  });
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-9) var(--space-8);
    border-bottom: 1px solid var(--line);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    min-width: 0;
  }

  .hero h1 {
    font-size: clamp(2.25rem, 1.2rem + 5vw, 4.25rem);
  }

  .lede {
    font-size: 1.125rem;
    max-width: 34rem;
    color: var(--steel);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero-console {
    display: flex;
    justify-content: center;
    align-items: center;
    min-width: 0;
  }

  .hero-image {
    width: 100%;
    max-width: 30rem;
    height: auto;
  }

  .hero-ai {
    width: 100%;
    max-width: 34rem;
  }

  .hero-ai-kicker {
    color: var(--signal);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    margin-bottom: var(--space-4);
  }

  .hero-ai-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    line-height: 1.05;
    margin-bottom: var(--space-5);
  }

  .hero-ai-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .hero-ai-list li {
    display: flex;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
    color: var(--text);
    font-size: 0.9375rem;
  }

  .hero-ai-list li span {
    color: var(--signal);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    padding-top: 0.2rem;
  }

  .hero-ai-foot {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    color: var(--steel);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
  }

  .hero-ai-foot span:first-child {
    color: var(--text);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .ai-more {
    display: flex;
    justify-content: flex-end;
    margin-top: var(--space-6);
  }

  .ai-plan-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-5);
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel-2);
  }

  .ai-plan-note > div {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
  }

  .ai-plan-note .mono {
    color: var(--signal);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
  }

  .ai-plan-note .muted {
    font-size: 0.8125rem;
  }

  .grid-3 {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
    align-items: stretch;
  }

  @media (min-width: 640px) {
    .grid-3 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .grid-3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .points {
    list-style: none;
    padding: 0;
    margin-top: auto;
    padding-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .points li {
    font-size: 0.8125rem;
    color: var(--steel);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.2rem 0.5rem;
  }

  .pillar-media {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    margin: calc(var(--space-5) * -1) calc(var(--space-5) * -1) var(--space-5);
    padding: var(--space-4);
    background: radial-gradient(120% 100% at 50% 0%, rgba(53, 214, 208, 0.1), transparent 70%);
    border-bottom: 1px solid var(--line);
  }

  .pillar-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 14px 26px rgba(0, 0, 0, 0.5));
  }

  .studio {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  .studio h2 {
    font-size: clamp(1.75rem, 1rem + 3vw, 3rem);
    margin-block: var(--space-3);
  }

  .studio-lead {
    max-width: 34rem;
  }

  /* Lista de canales estilo consola / tracklist */
  .channels {
    list-style: none;
    padding: 0;
    margin: var(--space-7) 0 0;
    border-top: 1px solid var(--line-paper);
  }

  .channel {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-2);
    border-bottom: 1px solid var(--line-paper);
    transition: background 0.15s ease, padding 0.15s ease;
  }

  .channel:hover {
    background: color-mix(in srgb, var(--ink-text) 4%, transparent);
    padding-inline: var(--space-4);
  }

  .channel__idx {
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    color: var(--signal);
    padding-top: 0.35rem;
  }

  .channel__text h3 {
    font-size: 1.0625rem;
    margin-bottom: var(--space-1);
    transition: color 0.15s ease;
  }

  .channel:hover .channel__text h3 {
    color: var(--signal);
  }

  .channel__text p {
    font-size: 0.9375rem;
    max-width: 32rem;
  }

  .channel__led {
    width: 0.5rem;
    height: 0.5rem;
    margin-top: 0.5rem;
    border-radius: 50%;
    background: var(--line-paper);
    transition: background 0.15s ease, box-shadow 0.15s ease;
  }

  .channel:hover .channel__led {
    background: var(--signal);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--signal) 18%, transparent);
  }

  /* Monitor: la captura enmarcada como modulo de consola */
  .monitor {
    margin: 0;
    display: flex;
    flex-direction: column;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-panel);
  }

  .monitor__strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--line);
    background: var(--panel-2);
  }

  .monitor__name {
    font-size: 0.6875rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--steel);
  }

  .monitor img {
    display: block;
    width: 100%;
    height: auto;
  }

  .monitor__screen {
    position: relative;
    display: block;
    line-height: 0;
  }

  .monitor__foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--line);
    background: var(--panel);
  }

  .monitor__foot .mono {
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--signal);
  }

  .highlight-code {
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    color: var(--steel);
  }

  .highlight {
    display: flex;
    flex-direction: column;
    border-top: 2px solid var(--line);
    padding-top: var(--space-5);
    transition: border-color 0.15s ease;
  }

  .highlight:hover {
    border-top-color: var(--signal);
  }

  .highlight__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .highlight__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--signal);
    background: color-mix(in srgb, var(--signal) 6%, transparent);
    transition: border-color 0.15s ease, box-shadow 0.15s ease, color 0.15s ease;
  }

  .highlight:hover .highlight__icon {
    color: var(--signal-strong);
    border-color: color-mix(in srgb, var(--signal) 45%, var(--line));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--signal) 14%, transparent);
  }

  .highlight h3 {
    margin-block: 0 var(--space-2);
  }

  .players {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  }

  .plan-from {
    margin-block: var(--space-5) var(--space-1);
    font-size: 1.125rem;
  }

  .plan-from .mono {
