---
import SiteLayout from '../layouts/SiteLayout.astro';
import ConsoleButton from '../components/ui/ConsoleButton.astro';
import Icon from '../components/ui/Icon.astro';
import Module from '../components/ui/Module.astro';
import OnAirBadge from '../components/ui/OnAirBadge.astro';
import HeroBackground from '../components/HeroBackground.astro';
import { getPanelPlanGroups } from '../lib/panel-plans';
import { formatUSD } from '../lib/format';
import { SITE } from '../lib/site';
import { getLocale, t } from '../lib/i18n';

const locale = getLocale(Astro.locals);
const tr = t(locale);
const groups = await getPanelPlanGroups(locale);
---

<SiteLayout page="planes" title={tr('plans.metaTitle')} description={tr('plans.metaDescription')}>
  <section class="band band--dark hero-band">
    <HeroBackground />
    <div class="container">
      <p class="eyebrow">{tr('plans.hero.eyebrow')}</p>
      <h1 class="display">{tr('plans.hero.title')}</h1>
      <p class="lede muted">{tr('plans.hero.description')}</p>
      <p class="hero-trial">
        <span class="hero-trial__tag mono">{tr('plans.hero.trialTag')}</span>
        {tr('plans.hero.trialText')}
      </p>
    </div>
  </section>

  {
    groups.length === 0 ? (
      <section class="band band--panel">
        <div class="container empty">
          <OnAirBadge label={tr('common.noSignal')} tone="danger" />
          <h2>{tr('plans.empty.title')}</h2>
          <p class="muted">{tr('plans.empty.text')}</p>
        </div>
      </section>
    ) : (
      groups.map((group, index) => (
        <section class:list={['band', index % 2 === 0 ? 'band--panel' : 'band--paper']}>
          <div class="container">
            <div class="section-head">
              <p class="eyebrow">[ {String(index + 1).padStart(2, '0')} / {group.label.toUpperCase()} ]</p>
              <h2>{group.label}</h2>
              {group.description && <p class="muted">{group.description}</p>}
            </div>

            <div class="plans">
              {group.plans.map((plan, planIndex) => (
                <Module label={String(planIndex + 1).padStart(2, '0')} led="signal">
                  <div class:list={['plan-media', { 'plan-media--bare': !plan.imageUrl }]}>
                    {plan.imageUrl && (
                      <img class="plan-image" src={plan.imageUrl} alt={plan.name} loading="lazy" />
                    )}
                    <span class="trial mono">{tr('plans.hero.trialTag')}</span>
                  </div>
                  <h3>{plan.name}</h3>
                  {plan.description && <p class="muted">{plan.description}</p>}

                  {plan.aiLiveEnabled && (
                    <div class="ai-badge">
                      <Icon name="mic" size={12} />
                      <span>{tr('plans.ai', { count: plan.aiMonthlyCharacters.toLocaleString(locale === 'en' ? 'en-US' : 'es-CL'), minutes: plan.aiMusicMinutes })}</span>
                    </div>
                  )}

                  <dl class="prices">
                    <div>
                      <dt class="mono">{tr('plans.usd')}</dt>
                      <dd class="mono price">{formatUSD(plan.usdAmount)}<span class="per">{plan.interval === 'yearly' ? tr('plans.perYear') : tr('plans.perMonth')}</span></dd>
                    </div>
                  </dl>

                  {plan.features && plan.features.length > 0 && (
                    <ul class="features">
                      {plan.features.map((feature) => <li>{feature}</li>)}
                    </ul>
                  )}

                  <div class="plan-actions">
                    <ConsoleButton
                      href={plan.contractUrl?.trim() || `mailto:${SITE.email}`}
                      target={/^https?:\/\//i.test(plan.contractUrl?.trim() ?? '') ? '_blank' : undefined}
                      rel={/^https?:\/\//i.test(plan.contractUrl?.trim() ?? '') ? 'noopener' : undefined}
                    >
                      {tr('plans.contract')}
                    </ConsoleButton>
                    {plan.demoUrl && (
                      <ConsoleButton variant="ghost" href={plan.demoUrl} target="_blank" rel="noopener">{tr('plans.demo')}</ConsoleButton>
                    )}
                  </div>
                </Module>
              ))}
            </div>
          </div>
        </section>
      ))
    )
  }

  <section class="band band--dark">
    <div class="container cta">
      <div>
        <p class="eyebrow">{tr('plans.cta.eyebrow')}</p>
        <h2 class="display">{tr('plans.cta.title')}</h2>
        <p class="muted">{tr('plans.cta.description')}</p>
      </div>
      <ConsoleButton href={`mailto:${SITE.email}`}>{tr('plans.cta.button')}</ConsoleButton>
    </div>
  </section>
</SiteLayout>

<style>
  .lede {
    margin-top: var(--space-4);
    max-width: 40rem;
  }

  .hero-trial {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--signal);
    border-radius: var(--radius);
    background: rgba(53, 214, 208, 0.08);
    color: var(--text);
    max-width: 40rem;
  }

  .hero-trial__tag {
    padding: var(--space-1) var(--space-3);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--ink);
    background: var(--signal);
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  .plans {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .plan-media {
    position: relative;
    margin-bottom: var(--space-4);
  }

  .plan-image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
  }

  .trial {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    padding: var(--space-1) var(--space-3);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--signal);
    border-radius: var(--radius-sm);
    box-shadow: 0 8px 20px -10px rgba(53, 214, 208, 0.9);
  }

  .plan-media--bare .trial {
    position: static;
    display: inline-block;
    color: var(--signal);
    background: transparent;
    border: 1px solid var(--line);
    box-shadow: none;
  }

  .prices {
    display: flex;
    gap: var(--space-6);
    margin-block: var(--space-5);
    padding-block: var(--space-4);
    border-block: 1px solid var(--line);
  }

  .prices dt {
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--steel);
  }

  .prices dd {
    margin: 0;
  }

  .price {
    font-size: 1.375rem;
    color: var(--signal);
  }

  .per {
    margin-left: 0.15rem;
    font-size: 0.75rem;
    color: var(--steel);
  }

  .ai-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding: 0.35rem 0.6rem;
    border: 1px solid color-mix(in srgb, var(--signal) 45%, var(--line));
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--signal) 8%, transparent);
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }

  .features {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .features li {
    position: relative;
    padding-left: 1.25rem;
    font-size: 0.9375rem;
    color: var(--steel);
  }

  .features li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.5rem;
    height: 2px;
    background: var(--signal);
  }

  .note {
    font-size: 0.6875rem;
    color: var(--steel);
    margin-bottom: var(--space-5);
  }

  .plan-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-5);
  }

  .empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }
</style>
