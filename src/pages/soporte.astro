---
import SiteLayout from '../layouts/SiteLayout.astro';
import ConsoleButton from '../components/ui/ConsoleButton.astro';
import Module from '../components/ui/Module.astro';
import HeroBackground from '../components/HeroBackground.astro';
import { SUPPORT_CARDS, FAQ } from '../lib/content';
import { SITE } from '../lib/site';

export const prerender = true;
---

<SiteLayout
  title="Soporte — IPStream"
  description="Centro de ayuda de IPStream: contacto, tutoriales y preguntas frecuentes para sacar el máximo provecho a tu radio online."
  social={null}
>
  <section class="band band--dark hero-band">
    <HeroBackground />
    <div class="container">
      <p class="eyebrow">[ SOPORTE ]</p>
      <h1 class="display">Estamos aquí para ayudarte</h1>
      <p class="lede muted">Nuestro equipo resuelve tus dudas y te ayuda a sacar el máximo provecho de tu radio online.</p>
    </div>
  </section>

  <section class="band band--panel" id="contacto">
    <div class="container">
      <div class="grid-3">
        {
          SUPPORT_CARDS.map((card) => (
            <Module label={card.action} led="signal">
              <h2>{card.title}</h2>
              <p class="muted">{card.description}</p>
              <div class="card-action">
                <ConsoleButton variant="ghost" href={card.href}>{card.action}</ConsoleButton>
              </div>
            </Module>
          ))
        }
      </div>
      <p class="contact mono">Escríbenos a <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    </div>
  </section>

  <section class="band band--paper" id="tutoriales">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">[ TUTORIALES ]</p>
        <h2>Aprende a usar tu plataforma</h2>
        <p class="muted">Guías paso a paso y videos explicativos, disponibles 24/7.</p>
      </div>
      <ConsoleButton href="/tutoriales">Ir a tutoriales</ConsoleButton>
    </div>
  </section>

  <section class="band band--dark" id="faq">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">[ FAQ ]</p>
        <h2>Preguntas frecuentes</h2>
      </div>
      <div class="faq">
        {
          FAQ.map((item) => (
            <details class="faq-item">
              <summary>{item.question}</summary>
              <p class="muted">{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .lede {
    margin-top: var(--space-4);
    max-width: 40rem;
  }

  .grid-3 {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .card-action {
    margin-top: var(--space-5);
  }

  .contact {
    margin-top: var(--space-6);
    color: var(--steel);
    font-size: 0.9375rem;
  }

  .contact a {
    color: var(--signal);
  }

  .faq {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }

  .faq-item {
    border-bottom: 1px solid var(--line);
    padding-block: var(--space-4);
  }

  .faq-item summary {
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::before {
    content: '+';
    font-family: var(--font-mono);
    color: var(--signal);
    margin-right: var(--space-3);
  }

  .faq-item[open] summary::before {
    content: '−';
  }

  .faq-item p {
    margin-top: var(--space-3);
    padding-left: var(--space-6);
  }
</style>
