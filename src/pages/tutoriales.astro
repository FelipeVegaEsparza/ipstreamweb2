---
import SiteLayout from '../layouts/SiteLayout.astro';
import OnAirBadge from '../components/ui/OnAirBadge.astro';
import HeroBackground from '../components/HeroBackground.astro';
import { getDatabase } from '../lib/db/client';
import { listTutorialsGroupedByCategory } from '../lib/db/repositories/tutorials';
import { SITE } from '../lib/site';
import { getLocale, t } from '../lib/i18n';

const locale = getLocale(Astro.locals);
const tr = t(locale);
const db = getDatabase();
const groups = listTutorialsGroupedByCategory(db, { activeOnly: true });
const total = groups.reduce((sum, group) => sum + group.tutorials.length, 0);
---

<SiteLayout page="tutoriales" title={tr('tutorials.metaTitle')} description={tr('tutorials.metaDescription')}>
  <section class="band band--dark hero-band">
    <HeroBackground />
    <div class="container">
      <p class="eyebrow">{tr('tutorials.hero.eyebrow')}</p>
      <h1 class="display">{tr('tutorials.hero.title')}</h1>
      <p class="lede muted">
        {total > 0 ? tr('tutorials.count', { count: total }) : tr('tutorials.comingSoon')}
      </p>
    </div>
  </section>

  {
    groups.length === 0 ? (
      <section class="band band--panel">
        <div class="container empty">
          <OnAirBadge label={tr('common.noSignal')} tone="danger" />
          <h2>{tr('tutorials.empty.title')}</h2>
          <p class="muted">{tr('tutorials.empty.text')}</p>
          <a class="link mono" href={`mailto:${SITE.email}`}>{tr('tutorials.empty.cta')}</a>
        </div>
      </section>
    ) : (
      groups.map((group, index) => (
        <section class:list={['band', index % 2 === 0 ? 'band--panel' : 'band--paper']}>
          <div class="container">
            <div class="section-head">
              <p class="eyebrow">[ {String(index + 1).padStart(2, '0')} / {group.category.name.toUpperCase()} ]</p>
              <h2>{group.category.name}</h2>
            </div>
            <div class="tutorials">
              {group.tutorials.map((tutorial) => (
                <article class="tutorial-row">
                  <div class="tutorial-row__meta">
                    <span class="tutorial-row__level mono">{tutorial.difficulty}</span>
                    {tutorial.duration && <span class="mono">{tutorial.duration}</span>}
                  </div>
                  <h3>{tutorial.title}</h3>
                  {tutorial.description && <p class="muted">{tutorial.description}</p>}
                  <div class="tutorial-row__foot">
                    <span class="mono">{tr('tutorials.views', { count: tutorial.views })}</span>
                    {tutorial.videoUrl && (
                      <a class="link mono" href={tutorial.videoUrl} rel="noopener external" target="_blank">{tr('tutorials.watch')}</a>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
      ))
    )
  }
</SiteLayout>

<style>
  .lede {
    margin-top: var(--space-4);
    max-width: 40rem;
  }

  .tutorials {
    --tutorial-line: var(--line);
    --tutorial-muted: var(--steel);
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 var(--space-7);
  }

  .band--paper .tutorials {
    --tutorial-line: var(--line-paper);
    --tutorial-muted: var(--muted-on-paper);
  }

  .tutorial-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-block: var(--space-5);
    border-top: 1px solid var(--tutorial-line);
    transition: border-color 0.15s ease;
  }

  .tutorial-row:hover {
    border-top-color: var(--signal);
  }

  .tutorial-row__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--tutorial-muted);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .tutorial-row__level {
    padding: 0.18rem 0.5rem;
    border: 1px solid var(--tutorial-line);
    border-radius: var(--radius-sm);
    color: var(--signal);
  }

  .tutorial-row h3 {
    font-size: 1.125rem;
  }

  .tutorial-row p {
    max-width: 48ch;
    font-size: 0.9375rem;
  }

  .tutorial-row__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-2);
    color: var(--tutorial-muted);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (min-width: 900px) {
    .tutorials {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .link {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--signal);
  }

  .band--paper .link {
    color: var(--signal);
  }

  .empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }
</style>
