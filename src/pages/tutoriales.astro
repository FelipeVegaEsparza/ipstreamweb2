---
import SiteLayout from '../layouts/SiteLayout.astro';
import Module from '../components/ui/Module.astro';
import OnAirBadge from '../components/ui/OnAirBadge.astro';
import HeroBackground from '../components/HeroBackground.astro';
import { getDatabase } from '../lib/db/client';
import { listTutorialsGroupedByCategory } from '../lib/db/repositories/tutorials';
import { SITE } from '../lib/site';
import { getLocale, t } from '../lib/i18n';

const locale = getLocale(Astro.locals);
const tr = t(locale);
const db = getDatabase();
const groups = listTutorialsGroupedByCategory(db, { activeOnly: true });
const total = groups.reduce((sum, group) => sum + group.tutorials.length, 0);
---

<SiteLayout page="tutoriales" title={tr('tutorials.metaTitle')} description={tr('tutorials.metaDescription')}>
  <section class="band band--dark hero-band">
    <HeroBackground />
    <div class="container">
      <p class="eyebrow">{tr('tutorials.hero.eyebrow')}</p>
      <h1 class="display">{tr('tutorials.hero.title')}</h1>
      <p class="lede muted">
        {total > 0 ? tr('tutorials.count', { count: total }) : tr('tutorials.comingSoon')}
      </p>
    </div>
  </section>

  {
    groups.length === 0 ? (
      <section class="band band--panel">
        <div class="container empty">
          <OnAirBadge label={tr('common.noSignal')} tone="danger" />
          <h2>{tr('tutorials.empty.title')}</h2>
          <p class="muted">{tr('tutorials.empty.text')}</p>
          <a class="link mono" href={`mailto:${SITE.email}`}>{tr('tutorials.empty.cta')}</a>
        </div>
      </section>
    ) : (
      groups.map((group, index) => (
        <section class:list={['band', index % 2 === 0 ? 'band--panel' : 'band--paper']}>
          <div class="container">
            <div class="section-head">
              <p class="eyebrow">[ {String(index + 1).padStart(2, '0')} / {group.category.name.toUpperCase()} ]</p>
              <h2>{group.category.name}</h2>
            </div>
            <div class="grid-3">
              {group.tutorials.map((tutorial) => (
                <Module label={tutorial.difficulty} led="signal">
                  <h3>{tutorial.title}</h3>
                  {tutorial.description && <p class="muted">{tutorial.description}</p>}
                  <p class="meta mono">
                    {tutorial.duration && <span>{tutorial.duration}</span>}
                    <span>{tr('tutorials.views', { count: tutorial.views })}</span>
                  </p>
                  {tutorial.videoUrl && (
                    <a class="link mono" href={tutorial.videoUrl} rel="noopener external" target="_blank">{tr('tutorials.watch')}</a>
                  )}
                </Module>
              ))}
            </div>
          </div>
        </section>
      ))
    )
  }
</SiteLayout>

<style>
  .lede {
    margin-top: var(--space-4);
    max-width: 40rem;
  }

  .grid-3 {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .meta {
    display: flex;
    gap: var(--space-4);
    margin-block: var(--space-4);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--steel);
  }

  .link {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--signal);
  }

  .band--paper .link {
    color: var(--signal);
  }

  .empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }
</style>
